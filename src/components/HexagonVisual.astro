---
interface Props {
  className?: string;
  size?: "sm" | "md" | "lg" | "responsive";
  interactive?: boolean;
  asSvgGroup?: boolean;
}

const { 
  className = "", 
  size = "responsive",
  interactive = true,
  asSvgGroup = false
} = Astro.props;

const sizeClasses = {
  sm: "w-40 h-40",
  md: "w-64 h-64",
  lg: "w-96 h-96",
  responsive: "w-full max-w-[380px] aspect-square"
}[size];
---

{asSvgGroup ? (
  <g class={`hexagon-visual-group select-none ${className}`} fill="none">
    <!-- Fixed Axis Coordinate Lines -->
    <g stroke="#27272a" stroke-width="1" stroke-dasharray="3 4">
      <line x1="0" y1="0" x2="0" y2="-210" />
      <line x1="0" y1="0" x2="181.8" y2="-105" />
      <line x1="0" y1="0" x2="181.8" y2="105" />
      <line x1="0" y1="0" x2="0" y2="210" />
      <line x1="0" y1="0" x2="-181.8" y2="105" />
      <line x1="0" y1="0" x2="-181.8" y2="-105" />
    </g>

    <!-- Concentric Range Circles -->
    <circle cx="0" cy="0" r="65" stroke="#1f242d" stroke-width="1" stroke-dasharray="2 3" fill="none" />
    <circle cx="0" cy="0" r="130" stroke="#1f242d" stroke-width="1" stroke-dasharray="2 4" fill="none" />
    <circle cx="0" cy="0" r="195" stroke="#1f242d" stroke-width="1" stroke-dasharray="1 5" fill="none" />

    <!-- Outer Polygon (Slow Clockwise Rotation, 100% Transparent Interior) -->
    <g class="outer-hex" fill="none">
      <polygon 
        points="0,-210 181.8,-105 181.8,105 0,210 -181.8,105 -181.8,-105" 
        stroke="#3f3f46" 
        stroke-width="1.2" 
        stroke-dasharray="12 8" 
        fill="none" 
      />
      <!-- 6 Vertex Nodes -->
      <circle cx="0" cy="-210" r="3" fill="#ffffff" />
      <circle cx="181.8" cy="-105" r="3" fill="#ffffff" />
      <circle cx="181.8" cy="105" r="3" fill="#ffffff" />
      <circle cx="0" cy="210" r="3" fill="#ffffff" />
      <circle cx="-181.8" cy="105" r="3" fill="#ffffff" />
      <circle cx="-181.8" cy="-105" r="3" fill="#ffffff" />
    </g>

    <!-- Middle Polygon (Counter-Clockwise Rotation, 100% Transparent Interior) -->
    <g class="middle-hex" fill="none">
      <polygon 
        points="0,-150 129.9,-75 129.9,75 0,150 -129.9,75 -129.9,-75" 
        stroke="#e4e4e7" 
        stroke-width="1.8" 
        fill="none" 
      />
      <!-- Corner ticks -->
      <rect x="-3" y="-153" width="6" height="6" fill="#ffffff" />
      <rect x="-3" y="147" width="6" height="6" fill="#ffffff" />
    </g>

    <!-- Inner Polygon (Breathe Animation, 100% Transparent Interior) -->
    <g class="inner-hex" fill="none">
      <polygon 
        points="0,-90 77.9,-45 77.9,45 0,90 -77.9,45 -77.9,-45" 
        stroke="#71717a" 
        stroke-width="1" 
        fill="none" 
      />
    </g>

    <!-- 360° Radar Sweep Line -->
    <g class="radar-sweep">
      <line 
        x1="0" 
        y1="0" 
        x2="0" 
        y2="-200" 
        stroke="#ffffff" 
        stroke-width="1.5" 
        stroke-linecap="round" 
        stroke-opacity="0.9" 
      />
      <path 
        d="M 0 0 L 25 -200 A 200 200 0 0 0 0 -200 Z" 
        fill="#ffffff" 
        fill-opacity="0.06" 
      />
    </g>

    <!-- Core Dot (Dead-center at 0, 0, Transparent Outer Ring) -->
    <circle cx="0" cy="0" r="14" stroke="#52525b" stroke-width="1" fill="none" />
    <circle cx="0" cy="0" r="5" fill="#ffffff" class="core-pulse" />

    <!-- HUD Coordinates -->
    <text x="-210" y="-218" class="text-[8px] font-mono fill-zinc-600 tracking-wider">HEX:60°</text>
    <text x="160" y="224" class="text-[8px] font-mono fill-zinc-500 tracking-wider">WOV://01</text>
  </g>
) : (
  <div 
    class={`hexagon-wrapper relative flex items-center justify-center select-none ${sizeClasses} ${className}`}
    data-interactive={interactive ? "true" : "false"}
  >
    <!-- Technical SVG Canvas -->
    <div class="hexagon-inner relative w-full h-full flex items-center justify-center transform-gpu transition-transform duration-150 ease-out">
      <svg 
        class="w-full h-full overflow-visible" 
        viewBox="-240 -240 480 480" 
        fill="none" 
        xmlns="http://www.w3.org/2000/svg"
      >
        <!-- Fixed Axis Coordinate Lines -->
        <g stroke="#27272a" stroke-width="1" stroke-dasharray="3 4">
          <line x1="0" y1="0" x2="0" y2="-210" />
          <line x1="0" y1="0" x2="181.8" y2="-105" />
          <line x1="0" y1="0" x2="181.8" y2="105" />
          <line x1="0" y1="0" x2="0" y2="210" />
          <line x1="0" y1="0" x2="-181.8" y2="105" />
          <line x1="0" y1="0" x2="-181.8" y2="-105" />
        </g>

        <!-- Concentric Range Circles -->
        <circle cx="0" cy="0" r="65" stroke="#1f242d" stroke-width="1" stroke-dasharray="2 3" fill="none" />
        <circle cx="0" cy="0" r="130" stroke="#1f242d" stroke-width="1" stroke-dasharray="2 4" fill="none" />
        <circle cx="0" cy="0" r="195" stroke="#1f242d" stroke-width="1" stroke-dasharray="1 5" fill="none" />

        <!-- Outer Polygon (Slow Clockwise Rotation, 100% Transparent Interior) -->
        <g class="outer-hex" fill="none">
          <polygon 
            points="0,-210 181.8,-105 181.8,105 0,210 -181.8,105 -181.8,-105" 
            stroke="#3f3f46" 
            stroke-width="1.2" 
            stroke-dasharray="12 8" 
            fill="none" 
          />
          <!-- 6 Vertex Nodes -->
          <circle cx="0" cy="-210" r="3" fill="#ffffff" />
          <circle cx="181.8" cy="-105" r="3" fill="#ffffff" />
          <circle cx="181.8" cy="105" r="3" fill="#ffffff" />
          <circle cx="0" cy="210" r="3" fill="#ffffff" />
          <circle cx="-181.8" cy="105" r="3" fill="#ffffff" />
          <circle cx="-181.8" cy="-105" r="3" fill="#ffffff" />
        </g>

        <!-- Middle Polygon (Counter-Clockwise Rotation, 100% Transparent Interior) -->
        <g class="middle-hex" fill="none">
          <polygon 
            points="0,-150 129.9,-75 129.9,75 0,150 -129.9,75 -129.9,-75" 
            stroke="#e4e4e7" 
            stroke-width="1.8" 
            fill="none" 
          />
          <!-- Corner ticks -->
          <rect x="-3" y="-153" width="6" height="6" fill="#ffffff" />
          <rect x="-3" y="147" width="6" height="6" fill="#ffffff" />
        </g>

        <!-- Inner Polygon (Breathe Animation, 100% Transparent Interior) -->
        <g class="inner-hex" fill="none">
          <polygon 
            points="0,-90 77.9,-45 77.9,45 0,90 -77.9,45 -77.9,-45" 
            stroke="#71717a" 
            stroke-width="1" 
            fill="none" 
          />
        </g>

        <!-- 360° Radar Sweep Line -->
        <g class="radar-sweep">
          <line 
            x1="0" 
            y1="0" 
            x2="0" 
            y2="-200" 
            stroke="#ffffff" 
            stroke-width="1.5" 
            stroke-linecap="round" 
            stroke-opacity="0.9" 
          />
          <path 
            d="M 0 0 L 25 -200 A 200 200 0 0 0 0 -200 Z" 
            fill="#ffffff" 
            fill-opacity="0.06" 
          />
        </g>

        <!-- Core Dot (Transparent Outer Ring) -->
        <circle cx="0" cy="0" r="14" stroke="#52525b" stroke-width="1" fill="none" />
        <circle cx="0" cy="0" r="5" fill="#ffffff" class="core-pulse" />

        <!-- HUD Coordinates -->
        <text x="-210" y="-218" class="text-[8px] font-mono fill-zinc-600 tracking-wider">HEX:60°</text>
        <text x="160" y="224" class="text-[8px] font-mono fill-zinc-500 tracking-wider">WOV://01</text>
      </svg>
    </div>
  </div>
)}

<style>
  .hexagon-wrapper {
    perspective: 800px;
  }
</style>

<script>
  // Mouse hover parallax tilt
  document.addEventListener("DOMContentLoaded", () => {
    const wrappers = document.querySelectorAll<HTMLElement>('.hexagon-wrapper[data-interactive="true"]');
    
    wrappers.forEach(wrapper => {
      const inner = wrapper.querySelector<HTMLElement>('.hexagon-inner');
      if (!inner) return;

      wrapper.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = wrapper.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;

        const rotateY = (x / (rect.width / 2)) * 10;
        const rotateX = -(y / (rect.height / 2)) * 10;

        inner.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      });

      wrapper.addEventListener('mouseleave', () => {
        inner.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg)';
      });
    });
  });
</script>
