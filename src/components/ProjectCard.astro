---
import type { HackathonProject } from "../config/team";

interface Props {
  project: HackathonProject;
  index?: number;
}

const { project, index = 0 } = Astro.props;
---

<div 
  class="group flex flex-col rounded-xl tech-panel overflow-hidden"
  data-scroll-reveal="card"
  style={`transition-delay: ${index * 80}ms;`}
>
  <!-- Image Banner -->
  <div class="relative w-full aspect-[16/9] overflow-hidden bg-zinc-950 border-b border-zinc-800">
    <img 
      src={project.image} 
      alt={project.title}
      class="w-full h-full object-cover group-hover:scale-105 transition-all duration-300"
      loading="lazy"
      onerror="this.src='https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=600&q=80'"
    />
    
    <!-- Award Tag -->
    {project.award && (
      <div class="absolute top-2.5 left-2.5">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono bg-black/80 text-white border border-zinc-700 backdrop-blur-sm">
          {project.award}
        </span>
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="p-5 flex flex-col flex-1">
    <div class="flex-1">
      <div class="flex items-baseline justify-between gap-2">
        <h3 class="text-base font-bold text-white group-hover:text-zinc-200 transition-colors">
          {project.title}
        </h3>
        <span class="text-[10px] font-mono text-zinc-500 uppercase">
          {project.category}
        </span>
      </div>

      <p class="text-xs font-mono text-zinc-400 mt-0.5">
        {project.tagline}
      </p>

      <p class="mt-2 text-xs text-zinc-400 font-light leading-relaxed">
        {project.description}
      </p>
    </div>

    <!-- Tech Tags -->
    <div class="mt-4 pt-3 border-t border-zinc-850 flex flex-wrap gap-1">
      {project.tags.map((tag) => (
        <span class="px-1.5 py-0.5 text-[10px] font-mono bg-zinc-900 border border-zinc-800 text-zinc-400 rounded">
          {tag}
        </span>
      ))}
    </div>

    <!-- Links -->
    <div class="mt-3.5 pt-1 flex items-center justify-between text-xs font-mono">
      {project.demoUrl && (
        <a 
          href={project.demoUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-white hover:underline inline-flex items-center gap-1"
        >
          <span>Demo</span>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}

      {project.githubUrl && (
        <a 
          href={project.githubUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-zinc-500 hover:text-white transition-colors"
        >
          Source →
        </a>
      )}
    </div>
  </div>
</div>
