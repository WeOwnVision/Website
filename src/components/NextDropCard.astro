---
import type { Locale } from "../i18n/translations";
import { translations } from "../i18n/translations";
import { siteConfig } from "../config/site";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const t = translations[locale].proof;
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
  <!-- Card 1: Next Target Hackathon -->
  <div 
    class="lg:col-span-7 rounded-2xl bg-theme-surface border border-theme p-6 sm:p-8 flex flex-col justify-between group hover:border-theme-strong transition-all"
    data-scroll-reveal="card"
  >
    <div class="space-y-4">
      <div class="flex items-center justify-between border-b border-theme pb-4">
        <span class="text-xs font-mono font-semibold tracking-wider text-theme-accent uppercase">
          {locale === 'tr' ? 'YOL HARİTASI' : 'ROADMAP'}
        </span>
        <span class="text-xs font-mono text-theme-muted">
          2026
        </span>
      </div>

      <div>
        <h3 class="text-xl sm:text-2xl font-bold text-theme-primary tracking-tight group-hover:text-theme-text-hover transition-colors">
          {t.nextTargetTitle}
        </h3>
        <p class="text-xs font-mono text-theme-secondary mt-1">
          {t.nextTargetSub}
        </p>
      </div>

      <p class="text-sm text-theme-secondary leading-relaxed font-normal pt-1">
        {t.nextTargetDescription}
      </p>
    </div>

    <div class="pt-6 mt-6 border-t border-theme flex items-center justify-between">
      <span class="text-xs font-mono text-theme-muted">
        {locale === 'tr' ? 'Format: 36 Saat' : 'Format: 36h Sprint'}
      </span>
      <a 
        href={siteConfig.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-theme-primary hover:text-theme-accent-hover transition-colors"
      >
        <span>{t.trackCommits}</span>
      </a>
    </div>
  </div>

  <!-- Card 2: This Website — Open Source -->
  <div 
    class="lg:col-span-5 rounded-2xl bg-theme-surface border border-theme p-6 sm:p-8 flex flex-col justify-between group hover:border-theme-strong transition-all"
    data-scroll-reveal="card"
    style="transition-delay: 80ms;"
  >
    <div class="space-y-4">
      <div class="flex items-center justify-between border-b border-theme pb-4">
        <span class="text-xs font-mono font-semibold text-theme-cognac uppercase">
          {locale === 'tr' ? 'AÇIK KAYNAK' : 'OPEN SOURCE'}
        </span>
        <span class="text-xs font-mono text-theme-muted">v0.4.0</span>
      </div>

      <div>
        <h3 class="text-xl font-bold text-theme-primary tracking-tight group-hover:text-theme-text-hover transition-colors">
          {t.flagshipTitle}
        </h3>
        <p class="text-xs font-mono text-theme-muted mt-1">
          {t.flagshipSub}
        </p>
      </div>

      <p class="text-sm text-theme-secondary leading-relaxed font-normal">
        {t.flagshipDesc}
      </p>

      <!-- Stack Chips -->
      <div class="flex flex-wrap gap-1.5 pt-2">
        <span class="px-2.5 py-1 text-xs font-mono bg-theme-base border border-theme text-theme-secondary rounded-md">Astro 5</span>
        <span class="px-2.5 py-1 text-xs font-mono bg-theme-base border border-theme text-theme-secondary rounded-md">TypeScript</span>
        <span class="px-2.5 py-1 text-xs font-mono bg-theme-base border border-theme text-theme-secondary rounded-md">Tailwind</span>
      </div>
    </div>

    <div class="pt-6 mt-6 border-t border-theme">
      <a 
        href={siteConfig.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold text-theme-primary hover:text-theme-text-hover bg-theme-base hover:bg-theme-elevated border border-theme hover:border-theme-strong transition-all"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        <span>{t.viewRepo}</span>
      </a>
    </div>
  </div>
</div>
