---
import '../styles/global.css';
import { dict, members, site, stack, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict[locale];
const toneClass = { primary: 'text-primary', surface: 'text-on-surface', tertiary: 'text-tertiary' } as const;
const linkHref = { github: site.github, twitter: site.twitter } as const;
const initials = (name: string) => name.split(' ').map((p) => p[0]).slice(0, 2).join('');
const commands = ['git clone https://github.com/WeOwnVision/Website.git', 'cd Website && npm install && npm run dev'];
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{t.htmlTitle}</title>
    <meta name="description" content={t.description} />
    <meta property="og:title" content={t.htmlTitle} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={site.url} />
    <meta name="theme-color" content="#0d0e11" />
    <link rel="alternate" hreflang="en" href={`${site.url}/`} />
    <link rel="alternate" hreflang="tr" href={`${site.url}/tr/`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" rel="stylesheet" />
  </head>

  <body>
    <!-- HEADER -->
    <header class="fixed top-0 inset-x-0 z-50 bg-surface-container-lowest/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.6)]">
      <div class="h-20 section-x flex items-center justify-between gap-space-md">
        <div class="flex items-center gap-space-lg">
          <a href={locale === 'tr' ? '/tr/' : '/'} class="flex items-center gap-space-sm group">
            <img src="/favicon.svg" alt="WOV" class="h-9 w-9" />
            <div class="flex flex-col">
              <span class="font-display text-headline-sm font-bold tracking-tight text-on-surface group-hover:text-primary transition-colors">WOV</span>
              <span class="font-mono text-label-sm tracking-widest text-outline uppercase">We Own Vision</span>
            </div>
          </a>
          <div class="hidden xl:flex items-center gap-space-xs px-space-sm py-space-xs rounded-full bg-surface-container-low shadow-[inset_0_0_12px_rgba(0,0,0,0.4)]">
            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
            <span class="font-mono text-label-sm text-tertiary">{t.statusPill}</span>
          </div>
        </div>
        <nav class="hidden lg:flex items-center gap-space-sm" aria-label="Primary">
          {t.nav.map((item) => (
            <a href={item.href} data-nav class="px-space-sm py-space-xs rounded-lg font-mono text-label-md uppercase tracking-wider text-on-surface-variant hover:text-on-surface transition-colors">{item.label}</a>
          ))}
        </nav>
        <div class="flex items-center gap-space-sm">
          <a href={t.langSwitch.href} class="px-space-sm py-space-xs rounded-lg font-mono text-label-md text-outline hover:text-primary transition-colors" hreflang={locale === 'en' ? 'tr' : 'en'}>{t.langSwitch.label}</a>
          <a href={site.github} target="_blank" rel="noopener" class="hidden sm:inline-flex items-center gap-space-xs px-space-md py-space-sm rounded-lg bg-surface-container font-mono text-label-md text-primary shadow-[0_0_16px_rgba(195,149,91,0.2)] hover:bg-surface-container-high hover:text-on-surface transition-all">
            <span class="material-symbols-outlined text-base">code</span>{t.githubCta}
          </a>
          <button id="menuBtn" class="lg:hidden w-9 h-9 rounded-lg bg-surface-container flex items-center justify-center text-primary" aria-label="Menu" aria-expanded="false" aria-controls="mobileNav">
            <span class="material-symbols-outlined">menu</span>
          </button>
        </div>
      </div>
      <nav id="mobileNav" class="hidden lg:hidden section-x pb-space-md flex-col gap-space-xs" aria-label="Mobile">
        {t.nav.map((item) => (
          <a href={item.href} class="py-space-sm font-mono text-label-lg uppercase tracking-wider text-on-surface-variant hover:text-primary">{item.label}</a>
        ))}
      </nav>
    </header>

    <main class="w-full pt-20">
      <!-- 1. HERO -->
      <section class="relative overflow-hidden section-x py-space-xl md:py-16 flex flex-col items-center">
        <div class="absolute inset-0 pointer-events-none opacity-40">
          <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] max-w-full rounded-full bg-gradient-to-tr from-primary-container/15 via-primary/5 to-transparent blur-3xl"></div>
          <div class="absolute top-1/2 right-10 w-72 h-72 rounded-full bg-secondary-container/10 blur-2xl"></div>
        </div>

        <div class="relative z-10 flex items-center gap-space-xs px-space-md py-space-xs rounded-full bg-surface-container shadow-md mb-space-lg">
          <span class="relative flex w-2 h-2"><span class="absolute inset-0 rounded-full bg-primary animate-ping"></span><span class="relative w-2 h-2 rounded-full bg-primary"></span></span>
          <span class="font-mono text-label-sm tracking-widest text-primary uppercase">{t.hero.pill}</span>
          <span class="text-outline-variant font-mono text-label-sm ml-space-xs hidden sm:inline">|</span>
          <span class="font-mono text-label-sm text-tertiary hidden sm:inline">NODE_STATE: V_ONLINE</span>
        </div>

        <div class="relative z-10 max-w-5xl text-center flex flex-col items-center">
          <div class="flex items-center justify-center gap-space-md mb-space-sm">
            <img src="/favicon.svg" alt="" class="h-12 md:h-14 w-auto drop-shadow-[0_0_16px_rgba(195,149,91,0.35)]" />
            <span class="font-mono text-label-lg tracking-[0.25em] text-outline uppercase font-semibold">{t.hero.collective}</span>
          </div>
          <h1 class="text-display-xl-mobile md:text-display-xl text-on-surface mb-space-md">
            {t.hero.line1} <br class="hidden sm:inline" />
            <span class="bg-gradient-to-r from-primary via-primary-fixed to-secondary bg-clip-text text-transparent">{t.hero.line2}</span>
          </h1>
          <p class="text-body-lg text-on-surface-variant max-w-3xl mb-space-xl">
            <strong class="text-on-surface font-semibold">{t.hero.lead}</strong> {t.hero.body}
          </p>
          <div class="flex flex-wrap items-center justify-center gap-space-md mb-space-xl">
            <a href="#builds" class="inline-flex items-center gap-space-xs px-space-lg py-space-sm rounded-lg bg-primary-container text-on-primary font-mono text-label-md uppercase tracking-wider font-semibold shadow-lg hover:bg-primary transition-all">
              <span class="material-symbols-outlined text-base">terminal</span>{t.hero.primaryCta}
            </a>
            <a href="#crew" class="inline-flex items-center gap-space-xs px-space-lg py-space-sm rounded-lg bg-surface-container text-tertiary font-mono text-label-md uppercase tracking-wider hover:bg-surface-container-high hover:text-on-surface transition-all">
              <span class="material-symbols-outlined text-base">groups</span>{t.hero.secondaryCta}
            </a>
          </div>
        </div>

        <!-- HUD -->
        <div class="relative z-10 w-full max-w-6xl">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter rounded-xl bg-surface-container-low p-space-md md:p-space-lg shadow-xl">
            <div class="lg:col-span-7 flex flex-col justify-between rounded-lg bg-surface-container p-space-md">
              <div class="flex items-center justify-between gap-space-sm pb-space-sm">
                <div class="flex items-center gap-space-xs font-mono text-label-sm text-primary uppercase min-w-0">
                  <span class="material-symbols-outlined text-sm">satellite_alt</span><span class="truncate">{t.hero.origin}</span>
                </div>
                <span class="font-mono text-label-sm text-tertiary shrink-0">UTC+3</span>
              </div>
              <div class="relative w-full h-44 my-space-sm bg-surface-container-lowest rounded overflow-hidden">
                <svg class="w-full h-full text-primary" fill="none" preserveAspectRatio="none" viewBox="0 0 600 160" aria-hidden="true">
                  <defs>
                    <linearGradient id="hudGrad" x1="0%" x2="100%" y1="0%" y2="0%">
                      <stop offset="0%" stop-color="#c3955b" stop-opacity="0.2" />
                      <stop offset="50%" stop-color="#f0be80" stop-opacity="0.8" />
                      <stop offset="100%" stop-color="#fb9f66" stop-opacity="0.3" />
                    </linearGradient>
                  </defs>
                  <path d="M0,40 H600 M0,80 H600 M0,120 H600" stroke="currentColor" stroke-dasharray="4 4" stroke-opacity="0.08" />
                  <path d="M100,0 V160 M250,0 V160 M400,0 V160 M520,0 V160" stroke="currentColor" stroke-dasharray="4 4" stroke-opacity="0.08" />
                  <path d="M40,120 C180,20 340,140 540,40" stroke="url(#hudGrad)" stroke-width="2.5" class="hud-path" />
                  <circle class="animate-pulse" cx="40" cy="120" fill="#f0be80" r="5" />
                  <circle cx="260" cy="70" fill="#fb9f66" r="3.5" />
                  <circle cx="390" cy="100" fill="#f0be80" r="3.5" />
                  <circle cx="540" cy="40" fill="#c3955b" r="6" />
                  <text fill="#9c8e81" font-family="JetBrains Mono" font-size="10" x="50" y="145">{t.hero.originLabel}</text>
                  <text fill="#f0be80" font-family="JetBrains Mono" font-size="10" x="420" y="25">{t.hero.targetLabel}</text>
                </svg>
                <div class="absolute bottom-2 right-3 font-mono text-label-sm text-outline">GLOBAL_MESH_ACTIVE</div>
              </div>
              <div class="flex flex-wrap items-center justify-between gap-space-xs font-mono text-label-sm text-on-surface-variant pt-space-xs">
                <span class="flex items-center gap-space-xs"><span class="w-1.5 h-1.5 rounded-full bg-primary"></span>{t.hero.target}</span>
                <span class="text-tertiary">{t.hero.targetNote}</span>
              </div>
            </div>
            <div class="lg:col-span-5 grid grid-cols-2 gap-space-sm">
              {t.hero.stats.map((s) => (
                <div class="bg-surface-container rounded-lg p-space-md flex flex-col justify-between gap-space-sm">
                  <span class="font-mono text-label-sm text-outline uppercase tracking-wider">{s.label}</span>
                  <div>
                    <span class={`font-display text-headline-lg font-bold ${toneClass[s.tone]}`}>{s.value}</span>
                    <p class="text-body-sm text-on-surface-variant mt-1">{s.note}</p>
                  </div>
                  <div class="font-mono text-label-sm text-tertiary">{s.foot}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 2. MANIFESTO -->
      <section id="manifesto" class="section-x py-space-xl md:py-16 bg-surface-container-lowest">
        <div class="max-w-6xl mx-auto flex flex-col gap-space-lg">
          <div class="eyebrow"><span class="font-bold">{t.manifesto.index}</span><span class="uppercase tracking-widest text-outline">{t.manifesto.eyebrow}</span></div>
          <div class="rounded-xl bg-surface-container p-space-lg md:p-space-xl relative overflow-hidden shadow-xl">
            <div class="absolute -right-16 -top-16 opacity-5 pointer-events-none"><span class="material-symbols-outlined !text-[240px]">public</span></div>
            <blockquote class="text-headline-lg-mobile md:text-headline-lg text-on-surface font-display font-medium max-w-4xl relative z-10">{t.manifesto.quote}</blockquote>
            <div class="flex items-center gap-space-md mt-space-lg relative z-10">
              <div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center font-display font-bold text-on-primary">W</div>
              <div>
                <div class="font-display text-headline-sm text-on-surface font-semibold">{t.manifesto.author}</div>
                <div class="font-mono text-label-sm text-tertiary">{t.manifesto.authorNote}</div>
              </div>
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
            {t.manifesto.pillars.map((p) => (
              <div class="bg-surface-container-low rounded-lg p-space-md flex flex-col justify-between hover:bg-surface-container transition-all">
                <div class="flex flex-col gap-space-xs">
                  <div class="flex items-center justify-between text-outline font-mono text-label-sm">
                    <span>{p.tag}</span><span class="material-symbols-outlined text-base text-primary">{p.icon}</span>
                  </div>
                  <h3 class="text-headline-sm text-on-surface font-semibold mt-space-xs">{p.title}</h3>
                  <p class="text-body-md text-on-surface-variant">{p.body}</p>
                </div>
                <div class="font-mono text-label-sm text-tertiary mt-space-md bg-surface-container-lowest/50 p-space-xs rounded">{p.foot}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 3. BUILDS -->
      <section id="builds" class="section-x py-space-xl md:py-16">
        <div class="max-w-6xl mx-auto flex flex-col gap-space-lg">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
            <div class="flex flex-col gap-space-xs">
              <div class="eyebrow"><span class="font-bold">{t.builds.index}</span><span class="uppercase tracking-widest text-outline">{t.builds.eyebrow}</span></div>
              <h2 class="text-headline-lg-mobile md:text-headline-lg font-bold text-on-surface">{t.builds.title}</h2>
            </div>
            <div class="font-mono text-label-sm text-tertiary">{t.builds.meta}</div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
            <div class="md:col-span-8 bg-surface-container rounded-xl p-space-lg flex flex-col justify-between gap-space-md shadow-lg relative overflow-hidden card-lift">
              <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-primary-container/10 blur-3xl pointer-events-none"></div>
              <div>
                <div class="flex flex-wrap items-center justify-between gap-space-xs mb-space-sm">
                  <span class="font-mono text-label-sm text-primary uppercase font-bold tracking-widest">{t.builds.next.tag}</span>
                  <span class="px-space-sm py-space-xs rounded-full bg-secondary-container text-on-secondary-container font-mono text-label-sm font-bold flex items-center gap-space-xs">
                    <span class="material-symbols-outlined !text-xs">emoji_events</span>{t.builds.next.badge}
                  </span>
                </div>
                <h3 class="text-headline-lg-mobile md:text-headline-lg text-on-surface font-bold mb-space-xs">{t.builds.next.title}</h3>
                <p class="text-body-md text-on-surface-variant max-w-2xl">{t.builds.next.body}</p>
              </div>
              <div class="relative flex flex-col gap-space-md">
                <div class="flex flex-wrap gap-space-xs font-mono text-label-sm">{t.builds.next.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
                <div class="flex flex-wrap items-center justify-between gap-space-sm font-mono text-label-sm">
                  <span class="flex items-center gap-space-xs text-outline"><span class="material-symbols-outlined text-sm text-primary">hourglass_top</span>{t.builds.next.foot}</span>
                  <a href={site.github} target="_blank" rel="noopener" class="px-space-md py-space-xs rounded bg-surface-container-highest text-primary hover:bg-primary-container hover:text-on-primary transition-all">{t.builds.next.cta}</a>
                </div>
              </div>
            </div>
            <div class="md:col-span-4 bg-surface-container rounded-xl p-space-lg flex flex-col justify-between gap-space-md shadow-lg card-lift">
              <div>
                <div class="flex items-center justify-between gap-space-xs mb-space-sm">
                  <span class="font-mono text-label-sm text-primary uppercase font-bold tracking-widest">{t.builds.site.tag}</span>
                  <span class="px-space-sm py-space-xs rounded-full bg-surface-container-high text-tertiary font-mono text-label-sm font-semibold flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>{t.builds.site.badge}</span>
                </div>
                <h3 class="text-headline-md text-on-surface font-bold mb-space-xs break-all">{t.builds.site.title}</h3>
                <p class="text-body-sm text-on-surface-variant">{t.builds.site.body}</p>
              </div>
              <div class="flex flex-col gap-space-sm">
                <div class="flex flex-wrap gap-space-xs font-mono text-label-sm">{t.builds.site.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
                <a href={site.repo} target="_blank" rel="noopener" class="self-end font-mono text-label-sm text-primary hover:underline">{t.builds.site.cta}</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 4. OPEN SOURCE -->
      <section id="open-source" class="section-x py-space-xl md:py-16 bg-surface-container-lowest">
        <div class="max-w-6xl mx-auto flex flex-col gap-space-lg">
          <div class="flex items-center justify-between">
            <div class="eyebrow"><span class="font-bold">{t.openSource.index}</span><span class="uppercase tracking-widest text-outline">{t.openSource.eyebrow}</span></div>
            <span class="font-mono text-label-sm text-tertiary hidden sm:inline">{t.openSource.meta}</span>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
            <div class="lg:col-span-7 bg-surface-container-low rounded-xl p-space-md shadow-xl flex flex-col">
              <div class="flex items-center justify-between pb-space-sm">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full bg-error/80"></div>
                  <div class="w-3 h-3 rounded-full bg-primary/80"></div>
                  <div class="w-3 h-3 rounded-full bg-outline/50"></div>
                  <span class="font-mono text-label-sm text-outline ml-2">bash ~ weownvision</span>
                </div>
                <button id="copyBtn" data-copy={commands.join('\n')} data-copied={t.openSource.copied} class="flex items-center gap-1 font-mono text-label-sm text-primary hover:text-on-surface transition-colors">
                  <span class="material-symbols-outlined text-sm">content_copy</span><span id="copyState">{t.openSource.copy}</span>
                </button>
              </div>
              <div class="flex-1 bg-surface-container-lowest rounded p-space-md font-mono text-label-md overflow-x-auto text-on-surface leading-relaxed whitespace-nowrap">
                <p class="text-outline">{t.openSource.comments[0]}</p>
                <p class="text-tertiary">$ {commands[0]}</p>
                <p class="text-outline mt-2">{t.openSource.comments[1]}</p>
                <p class="text-primary">$ {commands[1]}</p>
                <p class="text-on-surface-variant mt-2">&gt;&gt; astro dev</p>
                <p class="text-primary-container font-semibold">&gt;&gt; Local: http://localhost:4321/ <span class="inline-block w-2 h-3.5 bg-primary align-middle animate-pulse"></span></p>
              </div>
            </div>
            <div class="lg:col-span-5 bg-surface-container rounded-xl p-space-md shadow-xl flex flex-col justify-between gap-space-md">
              <div>
                <div class="flex items-center justify-between pb-space-xs font-mono text-label-sm">
                  <span class="text-on-surface font-semibold uppercase">{t.openSource.panelTitle}</span>
                  <span class="text-primary">{t.openSource.panelMeta}</span>
                </div>
                <p class="text-body-sm text-on-surface-variant mb-space-md">{t.openSource.panelBody}</p>
                <ol class="flex flex-col gap-space-xs">
                  {t.openSource.steps.map((step, i) => (
                    <li class="flex items-center gap-space-sm bg-surface-container-lowest rounded p-space-sm font-mono text-label-md">
                      <span class="w-6 h-6 shrink-0 rounded bg-primary-container/20 text-primary flex items-center justify-center text-label-sm">{i + 1}</span>
                      <span class={i === t.openSource.steps.length - 1 ? 'text-primary' : 'text-on-surface-variant'}>{step}</span>
                    </li>
                  ))}
                </ol>
              </div>
              <div class="flex flex-wrap items-center justify-between gap-space-xs font-mono text-label-sm">
                <span class="text-outline">{t.openSource.org}</span>
                <a href={site.github} target="_blank" rel="noopener" class="text-primary hover:underline">{t.openSource.orgCta}</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. DISCIPLINE & STACK -->
      <section class="section-x py-space-xl md:py-16">
        <div class="max-w-6xl mx-auto flex flex-col gap-space-lg">
          <div class="eyebrow"><span class="font-bold">{t.discipline.index}</span><span class="uppercase tracking-widest text-outline">{t.discipline.eyebrow}</span></div>
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
            <div class="lg:col-span-6 flex flex-col gap-space-md">
              <h2 class="text-headline-lg-mobile md:text-headline-lg font-bold text-on-surface">{t.discipline.title}</h2>
              <p class="text-body-lg text-on-surface-variant">{t.discipline.body}</p>
              <div class="flex flex-col gap-space-sm mt-space-xs">
                {t.discipline.items.map((item) => (
                  <div class="p-space-md rounded-lg bg-surface-container flex items-start gap-space-md">
                    <span class="material-symbols-outlined text-primary !text-2xl mt-1">{item.icon}</span>
                    <div>
                      <h3 class="text-headline-sm text-on-surface font-semibold">{item.title}</h3>
                      <p class="text-body-sm text-on-surface-variant">{item.body}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            <div class="lg:col-span-6 bg-surface-container-low rounded-xl p-space-lg shadow-xl flex flex-col gap-space-md">
              <div class="flex items-center justify-between pb-space-xs font-mono text-label-sm">
                <span class="text-outline uppercase font-semibold">{t.discipline.stackTitle}</span>
                <span class="text-primary">{t.discipline.stackMeta}</span>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-space-sm">
                {stack.map((s) => (
                  <div class="bg-surface-container p-space-md rounded-lg flex flex-col gap-1 hover:bg-surface-container-high transition-colors">
                    <span class={`font-display text-headline-sm font-bold ${s.accent ? 'text-primary' : 'text-on-surface'}`}>{s.name}</span>
                    <span class="font-mono text-label-sm text-outline">{s.note[locale]}</span>
                  </div>
                ))}
              </div>
              <div class="bg-surface-container p-space-md rounded-lg flex items-center gap-space-sm">
                <span class="material-symbols-outlined text-primary">shield_lock</span>
                <div>
                  <div class="font-mono text-label-md text-on-surface font-semibold">{t.discipline.extraTitle}</div>
                  <div class="text-body-sm text-on-surface-variant">{t.discipline.extraBody}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 6. CREW -->
      <section id="crew" class="section-x py-space-xl md:py-16 bg-surface-container-lowest">
        <div class="max-w-6xl mx-auto flex flex-col gap-space-lg">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
            <div class="flex flex-col gap-space-xs">
              <div class="eyebrow"><span class="font-bold">{t.crew.index}</span><span class="uppercase tracking-widest text-outline">{t.crew.eyebrow}</span></div>
              <h2 class="text-headline-lg-mobile md:text-headline-lg font-bold text-on-surface">{t.crew.title}</h2>
            </div>
            <p class="text-body-sm text-on-surface-variant max-w-md">{t.crew.body}</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-space-md">
            {members.map((m, i) => (
              <div class="bg-surface-container rounded-xl p-space-md flex flex-col justify-between shadow-lg card-lift">
                <div>
                  <div class="w-full aspect-square rounded-lg bg-surface-container-low mb-space-md overflow-hidden relative">
                    {m.avatar ? (
                      <img src={m.avatar} alt={m.name} loading="lazy" class="w-full h-full object-cover grayscale-[30%] sepia-[15%]" />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-surface-container-high to-surface-container-lowest font-display text-headline-lg text-primary">{initials(m.name)}</div>
                    )}
                    <div class="absolute bottom-2 left-2 px-space-xs py-0.5 rounded bg-surface-container-lowest/80 font-mono text-label-sm text-primary">ORIGIN_NODE_0{i + 1}</div>
                  </div>
                  <h3 class="text-headline-sm font-bold text-on-surface">{m.name}</h3>
                  <div class="font-mono text-label-sm text-primary uppercase mb-space-xs">{t.crew.roles[i].role}</div>
                  <p class="text-body-sm text-on-surface-variant mb-space-sm">{t.crew.roles[i].bio}</p>
                </div>
                <div class="flex flex-wrap gap-1 font-mono text-label-sm">{m.skills.map((s) => <span class="px-1.5 py-0.5 rounded bg-surface-container-high text-tertiary">{s}</span>)}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 7. CONTACT -->
      <section id="contact" class="section-x py-space-xl md:py-16">
        <div class="max-w-6xl mx-auto rounded-xl bg-gradient-to-r from-surface-container via-surface-container-low to-surface-container p-space-lg md:p-space-xl shadow-xl flex flex-col lg:flex-row items-center justify-between gap-space-xl">
          <div class="flex flex-col gap-space-sm max-w-xl">
            <div class="flex items-center gap-space-xs font-mono text-label-sm text-primary uppercase font-bold tracking-widest">
              <span class="material-symbols-outlined text-sm">handshake</span>{t.contact.eyebrow}
            </div>
            <h2 class="text-headline-lg-mobile md:text-headline-lg font-bold text-on-surface">{t.contact.title}</h2>
            <p class="text-body-md text-on-surface-variant">{t.contact.body}</p>
            <div class="flex flex-col sm:flex-row sm:items-center gap-space-sm mt-space-md">
              <a href={`mailto:${site.email}`} class="inline-flex items-center justify-center gap-space-xs px-space-lg py-space-sm rounded-lg bg-primary-container text-on-primary font-mono text-label-md font-semibold uppercase tracking-wider hover:bg-primary transition-all whitespace-nowrap">
                <span class="material-symbols-outlined text-base">mail</span>{t.contact.cta}
              </a>
              <span class="font-mono text-label-md text-tertiary">{site.email}</span>
            </div>
            <span class="font-mono text-label-sm text-outline">{t.contact.note}</span>
          </div>
          <div class="w-full lg:w-auto flex flex-col gap-space-sm bg-surface-container-lowest p-space-lg rounded-xl shadow-lg">
            <div class="font-display text-headline-sm font-semibold text-on-surface">{t.contact.hubTitle}</div>
            <p class="text-body-sm text-on-surface-variant max-w-xs">{t.contact.hubBody}</p>
            <div class="flex flex-col gap-space-xs pt-space-xs">
              {t.contact.links.map((l) => (
                <a href={linkHref[l.key]} target="_blank" rel="noopener" class="flex items-center justify-between gap-space-lg p-space-sm rounded bg-surface-container hover:bg-surface-container-high transition-colors font-mono text-label-md text-primary">
                  <span class="flex items-center gap-space-xs"><span class="material-symbols-outlined text-base">{l.icon}</span>{l.label}</span>
                  <span class="text-tertiary">{l.meta}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="bg-surface-container-lowest text-on-surface-variant">
      <div class="section-x py-space-xl">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter-lg pb-space-lg">
          <div class="md:col-span-6 flex flex-col gap-space-sm">
            <div class="flex items-center gap-space-sm">
              <img src="/favicon.svg" alt="" class="h-7 w-7" />
              <span class="font-display text-headline-sm text-on-surface font-semibold">WOV</span>
            </div>
            <p class="font-display text-headline-sm text-primary tracking-tight">{t.footer.motto}</p>
            <p class="text-body-sm text-outline max-w-md">{t.footer.about}</p>
          </div>
          <div class="md:col-span-3 flex flex-col gap-space-xs">
            <span class="font-mono text-label-md uppercase tracking-widest text-primary font-semibold mb-space-xs">{t.footer.basesTitle}</span>
            {t.footer.bases.map((b) => (
              <div class="flex items-center justify-between font-mono text-label-sm py-space-xs">
                <span class="text-on-surface">{b.k}</span><span class={'accent' in b ? 'text-primary' : 'text-tertiary'}>{b.v}</span>
              </div>
            ))}
          </div>
          <div class="md:col-span-3 flex flex-col gap-space-xs">
            <span class="font-mono text-label-md uppercase tracking-widest text-primary font-semibold mb-space-xs">{t.footer.commsTitle}</span>
            <div class="flex flex-col gap-space-xs font-mono text-label-md">
              <a href={site.github} target="_blank" rel="noopener" class="hover:text-primary transition-colors">GitHub // @WeOwnVision</a>
              <a href={site.twitter} target="_blank" rel="noopener" class="hover:text-primary transition-colors">X // @WeOwnVision</a>
              <a href={`mailto:${site.email}`} class="hover:text-primary transition-colors">Mail // {site.email}</a>
            </div>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row items-center justify-between pt-space-lg gap-space-md border-t border-outline-variant/30">
          <span class="font-mono text-label-sm text-outline">© {new Date().getFullYear()} {t.footer.rights}</span>
          <div class="flex items-center gap-space-lg font-mono text-label-sm">
            <span class="text-tertiary">SYS_STATUS: OPTIMAL</span>
            <span class="text-primary">ERZURUM // UTC+3</span>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('menuBtn');
      const mobileNav = document.getElementById('mobileNav');
      menuBtn?.addEventListener('click', () => {
        const open = mobileNav?.classList.toggle('hidden') === false;
        mobileNav?.classList.toggle('flex', open);
        menuBtn.setAttribute('aria-expanded', String(open));
      });
      mobileNav?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          mobileNav.classList.add('hidden');
          mobileNav.classList.remove('flex');
          menuBtn?.setAttribute('aria-expanded', 'false');
        }),
      );

      const copyBtn = document.getElementById('copyBtn');
      copyBtn?.addEventListener('click', async () => {
        const state = document.getElementById('copyState');
        try {
          await navigator.clipboard.writeText(copyBtn.dataset.copy ?? '');
          if (state) state.textContent = copyBtn.dataset.copied ?? '';
        } catch {
          /* clipboard unavailable */
        }
      });

      // Highlight the nav item for the section in view.
      const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
      const active = ['bg-primary-container', 'text-on-primary'];
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            links.forEach((l) => {
              const on = l.getAttribute('href') === `#${entry.target.id}`;
              l.classList.toggle(active[0], on);
              l.classList.toggle(active[1], on);
              l.classList.toggle('text-on-surface-variant', !on);
            });
          });
        },
        { rootMargin: '-45% 0px -50% 0px' },
      );
      links.forEach((l) => {
        const target = document.querySelector(l.getAttribute('href') ?? '');
        if (target) observer.observe(target);
      });
    </script>
  </body>
</html>
