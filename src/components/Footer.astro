---
import { siteConfig } from "../config/site";
const year = new Date().getFullYear();
---

<footer class="w-full border-t border-zinc-800 bg-black py-10 mt-20">
  <div class="max-w-5xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono">
    <!-- Brand -->
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-white"></span>
      <span class="text-white font-bold tracking-tight">WeOwnVision</span>
      <span class="text-zinc-500">// Hackathon Collective</span>
    </div>

    <!-- Links -->
    <div class="flex items-center space-x-5 text-zinc-400">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <a href="/about/" class="hover:text-white transition-colors">Team</a>
      <a href="/projects/" class="hover:text-white transition-colors">Projects</a>
      <a href="/posts/" class="hover:text-white transition-colors">Blog</a>
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GitHub</a>
    </div>

    <!-- Copyright -->
    <div class="text-zinc-600">
      © {year} WeOwnVision.
    </div>
  </div>
</footer>
