---
import { siteConfig } from "../config/site";
import type { Locale } from "../i18n/translations";
import { translations } from "../i18n/translations";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const t = translations[locale].footer;
const year = new Date().getFullYear();
const isTr = locale === "tr";
---

<footer class="w-full border-t border-theme bg-theme-base py-12 mt-20">
  <div class="max-w-5xl mx-auto px-6 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-6 text-xs text-theme-muted">
    <!-- Brand Info -->
    <div class="flex items-center gap-3">
      <div class="w-4 h-4 flex items-center justify-center">
        <svg class="w-full h-full" viewBox="0 0 24 24" fill="none">
          <rect x="3" y="3" width="18" height="18" rx="4" stroke="currentColor" class="text-theme-primary" stroke-width="2" />
          <circle cx="12" cy="12" r="3.5" class="fill-theme-accent" />
        </svg>
      </div>
      <span class="text-sm font-semibold tracking-tight text-theme-primary">WeOwnVision</span>
      <span>•</span>
      <span>{t.brandDesc}</span>
    </div>

    <!-- Links -->
    <div class="flex items-center gap-6">
      <a href={isTr ? "/tr/" : "/"} class="hover:text-theme-text-hover transition-colors">
        {isTr ? "Anasayfa" : "Home"}
      </a>
      <a href={isTr ? "/tr/about/" : "/about/"} class="hover:text-theme-text-hover transition-colors">
        {isTr ? "Hakkımızda" : "About"}
      </a>
      <a href={isTr ? "/tr/projects/" : "/projects/"} class="hover:text-theme-text-hover transition-colors">
        {isTr ? "Projeler" : "Projects"}
      </a>
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="hover:text-theme-text-hover transition-colors">
        GitHub
      </a>
    </div>

    <!-- Copyright -->
    <div>
      © {year} WeOwnVision.
    </div>
  </div>
</footer>
