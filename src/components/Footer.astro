---
import { siteConfig } from "../config/site";
const year = new Date().getFullYear();
---

<footer class="w-full border-t border-white/[0.08] bg-[#0A0A0B] py-12 mt-20">
  <div class="max-w-5xl mx-auto px-6 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
    <!-- Brand -->
    <div class="flex items-center gap-2.5">
      <div class="w-4 h-4 flex items-center justify-center">
        <svg class="w-full h-full" viewBox="-50 -50 100 100" fill="none">
          <polygon points="0,-42 36.4,-21 36.4,21 0,42 -36.4,21 -36.4,-21" stroke="#EDEDEF" stroke-width="7" />
          <circle cx="0" cy="0" r="10" fill="#FF5B1F" />
        </svg>
      </div>
      <span class="text-sm font-semibold tracking-tight text-[#EDEDEF]">WeOwnVision</span>
      <span class="text-xs text-[#8A8A93] ml-1" data-en="Hackathon Collective" data-tr="Hackathon Kolektifi">Hackathon Collective</span>
    </div>

    <!-- Links -->
    <div class="flex items-center gap-6 text-sm text-[#A1A1AA]">
      <a href="/" class="hover:text-[#EDEDEF] transition-colors" data-en="Home" data-tr="Ana Sayfa">Home</a>
      <a href="/about/" class="hover:text-[#EDEDEF] transition-colors" data-en="About" data-tr="Hakkımızda">About</a>
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="hover:text-[#EDEDEF] transition-colors">GitHub</a>
    </div>

    <!-- Copyright -->
    <div class="text-xs text-[#8A8A93]">
      © {year} WeOwnVision.
    </div>
  </div>
</footer>
