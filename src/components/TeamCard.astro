---
import type { TeamMember } from "../config/team";

interface Props {
  member: TeamMember;
  index?: number;
}

const { member, index = 0 } = Astro.props;
---

<div 
  class="group py-4 sm:py-5 border-b border-white/[0.08] grid grid-cols-1 md:grid-cols-12 gap-4 items-center transition-colors hover:bg-white/[0.015]"
  data-scroll-reveal="card"
  style={`transition-delay: ${index * 40}ms;`}
>
  <!-- Col 1: Photo + Name + Role (md:col-span-4) -->
  <div class="md:col-span-4 flex items-center gap-3.5">
    <div class="w-10 h-10 rounded-lg overflow-hidden flex-shrink-0 border border-white/10 group-hover:border-white/30 transition-all bg-[#111113]">
      <img 
        src={member.avatar} 
        alt={member.name} 
        class="w-full h-full object-cover" 
        loading="lazy" 
      />
    </div>
    <div class="min-w-0">
      <div class="flex items-baseline gap-2">
        <h3 class="text-sm sm:text-base font-semibold text-[#EDEDEF] group-hover:text-white transition-colors tracking-tight truncate">
          {member.name}
        </h3>
        <span 
          class="text-[11px] font-mono text-[#8A8A93] tracking-wide flex-shrink-0"
          data-en={`· ${member.role.toUpperCase()}`}
          data-tr={`· ${member.roleTr.toUpperCase()}`}
        >
          · {member.role.toUpperCase()}
        </span>
      </div>
    </div>
  </div>

  <!-- Col 2: Bio (md:col-span-5, strictly <= 70 chars, no ellipsis) -->
  <div class="md:col-span-5">
    <p 
      class="text-xs sm:text-sm text-[#A1A1AA] font-normal leading-relaxed"
      data-en={member.bio}
      data-tr={member.bioTr}
    >
      {member.bio}
    </p>
  </div>

  <!-- Col 3: Chips + Social Links (md:col-span-3, single line, 2 chips max) -->
  <div class="md:col-span-3 flex items-center justify-between md:justify-end gap-3">
    <div class="flex items-center gap-1.5 flex-nowrap">
      {member.skills.slice(0, 2).map((skill) => (
        <span class="px-2 py-0.5 text-[11px] font-mono bg-white/[0.04] border border-white/[0.08] text-[#8A8A93] rounded whitespace-nowrap">
          {skill}
        </span>
      ))}
    </div>

    <div class="flex items-center gap-0.5 flex-shrink-0">
      {member.social.github && (
        <a 
          href={member.social.github} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-7 h-7 rounded-md flex items-center justify-center text-[#8A8A93] hover:text-[#EDEDEF] hover:bg-white/5 transition-all opacity-70 hover:opacity-100" 
          aria-label={`${member.name} GitHub`}
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
      )}
      {member.social.twitter && (
        <a 
          href={member.social.twitter} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-7 h-7 rounded-md flex items-center justify-center text-[#8A8A93] hover:text-[#EDEDEF] hover:bg-white/5 transition-all opacity-70 hover:opacity-100" 
          aria-label={`${member.name} Twitter`}
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
      )}
    </div>
  </div>
</div>
