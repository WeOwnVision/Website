---
import type { TeamMember } from "../config/team";

interface Props {
  member: TeamMember;
  index?: number;
}

const { member, index = 0 } = Astro.props;
---

<div 
  class="group py-5 sm:py-6 border-b border-white/[0.08] flex flex-col md:flex-row md:items-center justify-between gap-4 transition-colors hover:bg-white/[0.015] px-2 -mx-2 rounded-lg"
  data-scroll-reveal="card"
  style={`transition-delay: ${index * 45}ms;`}
>
  <!-- Left Column: Avatar + Name + Role -->
  <div class="flex items-center gap-4 min-w-[240px]">
    <div class="w-12 h-12 rounded-lg overflow-hidden flex-shrink-0 border border-white/10 group-hover:border-white/30 transition-all group-hover:scale-105 bg-[#111113]">
      <img 
        src={member.avatar} 
        alt={member.name} 
        class="w-full h-full object-cover" 
        loading="lazy" 
      />
    </div>
    <div>
      <div class="flex items-center gap-2">
        <h3 class="text-base font-semibold text-[#EDEDEF] group-hover:text-white transition-colors">
          {member.name}
        </h3>
        <span class="text-[11px] font-mono text-[#FF5B1F] bg-[#FF5B1F]/10 border border-[#FF5B1F]/20 px-1.5 py-0.5 rounded">
          {member.role}
        </span>
      </div>
      <p class="text-xs font-mono text-[#8A8A93] mt-0.5">
        {member.speciality}
      </p>
    </div>
  </div>

  <!-- Middle Column: Focus Description -->
  <p class="text-sm text-[#A1A1AA] leading-relaxed max-w-md md:px-4 font-normal">
    {member.bio}
  </p>

  <!-- Right Column: Skills & Social Links -->
  <div class="flex items-center justify-between md:justify-end gap-4 flex-shrink-0">
    <div class="flex flex-wrap gap-1.5">
      {member.skills.slice(0, 3).map((skill) => (
        <span class="px-2 py-0.5 text-xs font-mono bg-white/[0.04] border border-white/[0.08] text-[#A1A1AA] rounded">
          {skill}
        </span>
      ))}
    </div>

    <div class="flex items-center gap-1">
      {member.social.github && (
        <a 
          href={member.social.github} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-8 h-8 rounded-md flex items-center justify-center text-[#8A8A93] hover:text-[#EDEDEF] hover:bg-white/5 transition-all opacity-70 hover:opacity-100" 
          aria-label={`${member.name} GitHub`}
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
      )}
      {member.social.twitter && (
        <a 
          href={member.social.twitter} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-8 h-8 rounded-md flex items-center justify-center text-[#8A8A93] hover:text-[#EDEDEF] hover:bg-white/5 transition-all opacity-70 hover:opacity-100" 
          aria-label={`${member.name} Twitter`}
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
      )}
    </div>
  </div>
</div>
