---
import { siteConfig } from "../config/site";
import type { Locale } from "../i18n/translations";
import { translations } from "../i18n/translations";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const t = translations[locale].nav;
const currentPath = Astro.url.pathname;
const isTr = locale === "tr";

const navLinks = [
  { name: t.home, href: isTr ? "/tr/" : "/" },
  { name: t.about, href: isTr ? "/tr/about/" : "/about/" },
  { name: t.builds, href: isTr ? "/tr/projects/" : "/projects/" },
];
---

<header class="sticky top-0 z-50 w-full bg-theme-base/90 backdrop-blur-md border-b border-theme transition-all">
  <div class="max-w-5xl mx-auto px-6 sm:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={isTr ? "/tr/" : "/"} class="flex items-center gap-3 group">
      <div class="w-6 h-6 flex items-center justify-center">
        <svg class="w-full h-full transform transition-transform duration-300 group-hover:rotate-45" viewBox="0 0 24 24" fill="none">
          <rect x="3" y="3" width="18" height="18" rx="4" stroke="currentColor" class="text-theme-primary" stroke-width="2" />
          <circle cx="12" cy="12" r="3.5" class="fill-theme-accent" />
        </svg>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-sm font-bold tracking-tight text-theme-primary">
          WeOwnVision
        </span>
        <span class="text-[10px] font-mono tracking-wider text-theme-muted uppercase">
          Atatürk Univ.
        </span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map((item) => {
        const isActive = currentPath === item.href || (item.href !== "/" && item.href !== "/tr/" && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`text-sm font-medium transition-colors relative py-1 ${
              isActive
                ? "text-theme-primary"
                : "text-theme-secondary hover:text-theme-text-hover"
            }`}
          >
            {item.name}
            {isActive && (
              <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-theme-accent rounded-full"></span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Right Actions: GitHub Only -->
    <div class="flex items-center gap-3">
      <a
        href={siteConfig.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-semibold text-theme-primary hover:text-theme-text-hover bg-theme-surface hover:bg-theme-elevated border border-theme hover:border-theme-strong rounded-lg transition-all"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        <span>GitHub</span>
      </a>

      <!-- Mobile Menu Button -->
      <button 
        id="mobile-nav-toggle"
        type="button" 
        class="md:hidden p-2 rounded-lg text-theme-secondary hover:text-theme-text-hover hover:bg-theme-surface"
        aria-label="Toggle navigation"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden px-6 py-4 border-t border-theme bg-theme-base flex flex-col gap-2">
    {navLinks.map((item) => (
      <a
        href={item.href}
        class="px-3 py-2 rounded-md text-sm font-medium text-theme-secondary hover:text-theme-text-hover hover:bg-theme-surface transition-colors"
      >
        {item.name}
      </a>
    ))}
  </div>
</header>

<script>
  // Automatic language routing for Turkish visitors if visiting the root
  if (typeof window !== "undefined" && window.location.pathname === "/") {
    const userLang = navigator.language || (navigator as any).userLanguage || "";
    if (userLang.toLowerCase().startsWith("tr") && !sessionStorage.getItem("wov_lang_viewed")) {
      sessionStorage.setItem("wov_lang_viewed", "true");
      window.location.replace("/tr/");
    }
  }

  const btn = document.getElementById("mobile-nav-toggle");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>
