---
import { siteConfig } from "../config/site";
const currentPath = Astro.url.pathname;
---

<header class="sticky top-5 z-50 w-full px-4 max-w-5xl mx-auto animate-nav-enter">
  <nav class="bg-[#09090b]/90 backdrop-blur-md border border-[#27272a] rounded-full px-5 py-2.5 flex items-center justify-between shadow-2xl transition-all">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-5 h-5 flex items-center justify-center">
        <svg class="w-full h-full transform transition-transform duration-300 group-hover:rotate-180" viewBox="-50 -50 100 100">
          <polygon points="0,-42 36.4,-21 36.4,21 0,42 -36.4,21 -36.4,-21" stroke="#ffffff" stroke-width="7" fill="none" />
          <circle cx="0" cy="0" r="10" fill="#ffffff" />
        </svg>
      </div>
      <span class="text-sm font-bold tracking-tight text-white font-mono">
        WeOwn<span class="text-zinc-400">Vision</span>
      </span>
    </a>

    <!-- Navigation Links -->
    <div class="hidden sm:flex items-center space-x-1">
      {siteConfig.nav.map((item) => {
        const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-3 py-1 rounded-full text-xs font-mono transition-colors ${
              isActive
                ? "bg-white text-black font-semibold"
                : "text-zinc-400 hover:text-white hover:bg-zinc-800/60"
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </div>

    <!-- GitHub Repo Shortcut -->
    <div class="flex items-center gap-2">
      <a
        href={siteConfig.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono rounded-full bg-zinc-900 hover:bg-zinc-800 text-zinc-300 border border-zinc-800 hover:border-zinc-700 transition-colors"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        <span>GitHub</span>
      </a>

      <!-- Mobile Menu Toggle -->
      <button 
        id="mobile-nav-toggle"
        type="button" 
        class="sm:hidden p-1.5 rounded-full text-zinc-400 hover:text-white"
        aria-label="Toggle menu"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden sm:hidden mt-2 p-3 rounded-2xl bg-[#09090b] border border-[#27272a] flex flex-col gap-1">
    {siteConfig.nav.map((item) => (
      <a
        href={item.href}
        class="px-3 py-1.5 rounded-lg text-xs font-mono text-zinc-300 hover:bg-zinc-800 transition-colors"
      >
        {item.name}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-nav-toggle");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>
