---
import { siteConfig } from "../config/site";
const currentPath = Astro.url.pathname;

const navTranslations: Record<string, { en: string; tr: string }> = {
  "/": { en: "Home", tr: "Ana Sayfa" },
  "/about/": { en: "About", tr: "Hakkımızda" },
};
---

<header class="sticky top-0 z-50 w-full bg-[#0A0A0B]/85 backdrop-blur-md border-b border-white/[0.08] transition-all">
  <div class="max-w-5xl mx-auto px-6 sm:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-5 h-5 flex items-center justify-center">
        <svg class="w-full h-full transform transition-transform duration-300 group-hover:rotate-60" viewBox="-50 -50 100 100" fill="none">
          <polygon points="0,-42 36.4,-21 36.4,21 0,42 -36.4,21 -36.4,-21" stroke="#EDEDEF" stroke-width="7" />
          <circle cx="0" cy="0" r="10" fill="#FF5B1F" />
        </svg>
      </div>
      <span class="text-sm font-bold tracking-tight text-[#EDEDEF]">
        WeOwnVision
      </span>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden sm:flex items-center gap-6">
      {siteConfig.nav.map((item) => {
        const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
        const labels = navTranslations[item.href] || { en: item.name, tr: item.name };
        return (
          <a
            href={item.href}
            class={`text-sm font-medium transition-colors relative py-1 ${
              isActive
                ? "text-[#EDEDEF]"
                : "text-[#A1A1AA] hover:text-[#EDEDEF]"
            }`}
            data-en={labels.en}
            data-tr={labels.tr}
          >
            {labels.en}
            {isActive && (
              <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-[#FF5B1F] rounded-full"></span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- GitHub CTA -->
    <div class="flex items-center gap-3">
      <a
        href={siteConfig.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-medium text-[#EDEDEF] bg-[#111113] hover:bg-white/10 border border-white/10 rounded-lg transition-colors"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        <span>GitHub</span>
      </a>

      <!-- Mobile Menu Button -->
      <button 
        id="mobile-nav-toggle"
        type="button" 
        class="sm:hidden p-2 rounded-lg text-[#A1A1AA] hover:text-[#EDEDEF] hover:bg-white/5"
        aria-label="Toggle navigation"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden sm:hidden px-6 py-4 border-t border-white/[0.08] bg-[#0A0A0B] flex flex-col gap-2">
    {siteConfig.nav.map((item) => {
      const labels = navTranslations[item.href] || { en: item.name, tr: item.name };
      return (
        <a
          href={item.href}
          class="px-3 py-2 rounded-md text-sm font-medium text-[#A1A1AA] hover:text-[#EDEDEF] hover:bg-white/5 transition-colors"
          data-en={labels.en}
          data-tr={labels.tr}
        >
          {labels.en}
        </a>
      );
    })}
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-nav-toggle");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>
