---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ScrollObserver from "../components/ScrollObserver.astro";
import { siteConfig } from "../config/site";
import { teamData } from "../config/team";
---

<!DOCTYPE html>
<html lang="en" class="bg-[#0A0A0B] text-[#EDEDEF]">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Projects & Builds | {siteConfig.title}</title>
    <meta name="description" content="Explore hackathon projects and software drops engineered by WeOwnVision." />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>

  <body class="min-h-screen bg-[#0A0A0B] text-[#EDEDEF] flex flex-col relative selection:bg-[#EDEDEF] selection:text-[#0A0A0B]">
    <Navigation />

    <main class="relative z-10 flex-1 max-w-5xl mx-auto px-6 sm:px-8 py-16 w-full">
      <div class="text-left max-w-2xl mb-12" data-scroll-reveal="text">
        <span class="text-xs font-mono text-[#8A8A93] uppercase tracking-wider">
          ARCHIVE / REPOSITORIES
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-[#EDEDEF] tracking-tight mt-2">
          Hackathon Drops
        </h1>
        <p class="mt-3 text-base text-[#A1A1AA] font-normal leading-relaxed">
          Repositories, architecture teardowns, and live deployments built during 36-hour sprint constraints.
        </p>
      </div>

      {teamData.projects.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {teamData.projects.map((project, idx) => (
            <ProjectCard project={project} index={idx} />
          ))}
        </div>
      ) : (
        <div class="border-t border-white/[0.08] pt-10" data-scroll-reveal="card">
          <p class="text-sm text-[#A1A1AA] leading-relaxed">
            First project write-ups and public repositories will be deployed here following our upcoming hackathons.
          </p>
          <div class="mt-4">
            <a 
              href={siteConfig.social.github} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 text-sm font-medium text-[#EDEDEF] hover:underline"
            >
              <span>Track real-time commits on GitHub</span>
              <span>→</span>
            </a>
          </div>
        </div>
      )}
    </main>

    <Footer />
    <ScrollObserver />
  </body>
</html>
