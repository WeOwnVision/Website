---
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import ScrollObserver from "../../components/ScrollObserver.astro";
import ThemeHead from "../../components/ThemeHead.astro";
import { siteConfig } from "../../config/site";
import { getPostBySlug, getAllPostSlugs } from "../../utils/getPosts";

export async function getStaticPaths() {
  const slugs = getAllPostSlugs();
  return slugs.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/posts/");
}

const post = getPostBySlug(slug);

if (!post) {
  return Astro.redirect("/posts/");
}

const { frontmatter, Content } = post;
---

<!DOCTYPE html>
<html lang="en" class="bg-theme-base text-theme-primary">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{frontmatter.title} | {siteConfig.name}</title>
    <meta name="description" content={frontmatter.description} />
    <ThemeHead />
  </head>

  <body class="min-h-screen bg-theme-base text-theme-primary flex flex-col relative selection:bg-theme-accent selection:text-theme-base">

    <Navigation />

    <main class="relative z-10 flex-1 max-w-3xl mx-auto px-4 sm:px-6 py-16 w-full">
      <a 
        href="/posts/" 
        class="inline-flex items-center gap-1.5 text-xs font-mono text-theme-muted hover:text-theme-text-hover transition-colors mb-8"
      >
        <span>← Back to Dispatches</span>
      </a>

      <header class="mb-10">
        <div class="flex items-center gap-3 text-xs font-mono text-theme-muted mb-2">
          <span>{frontmatter.date}</span>
          <span>•</span>
          <span>{frontmatter.readTime}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold text-theme-primary tracking-tight leading-tight">
          {frontmatter.title}
        </h1>

        <p class="mt-3 text-sm text-theme-secondary font-light leading-relaxed">
          {frontmatter.description}
        </p>
      </header>

      <article class="prose prose-invert prose-zinc max-w-none prose-headings:font-display prose-headings:font-bold prose-code:font-mono p-6 sm:p-8 rounded-xl bg-theme-surface border border-theme">
        <Content />
      </article>
    </main>

    <Footer />
    <ScrollObserver />
  </body>
</html>
