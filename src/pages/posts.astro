---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import ScrollObserver from "../components/ScrollObserver.astro";
import { siteConfig } from "../config/site";
import { getAllPosts } from "../utils/getPosts";

const allPosts = getAllPosts();
---

<!DOCTYPE html>
<html lang="en" class="bg-[#0A0A0B] text-[#EDEDEF]">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Dispatches & Blog | {siteConfig.title}</title>
    <meta name="description" content="Technical writeups, hackathon post-mortems, and engineering insights from WeOwnVision." />
    <link rel="stylesheet" href="/src/styles/global.css" />
      <!-- Automatic Turkish Language Detector -->
    <script is:inline>
      (function() {
        function checkLanguage() {
          var lang = (navigator.language || navigator.userLanguage || "").toLowerCase();
          if (lang.startsWith("tr")) {
            document.documentElement.lang = "tr";
            document.querySelectorAll("[data-tr]").forEach(function(el) {
              el.textContent = el.getAttribute("data-tr");
            });
            document.querySelectorAll("[data-tr-html]").forEach(function(el) {
              el.innerHTML = el.getAttribute("data-tr-html");
            });
          }
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", checkLanguage);
        } else {
          checkLanguage();
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-[#0A0A0B] text-[#EDEDEF] flex flex-col relative selection:bg-[#EDEDEF] selection:text-[#0A0A0B]">
    <Navigation />

    <main class="relative z-10 flex-1 max-w-5xl mx-auto px-6 sm:px-8 py-16 w-full">
      <div class="text-left max-w-2xl mb-12" data-scroll-reveal="text">
        <span class="text-xs font-mono text-[#8A8A93] uppercase tracking-wider">
          DISPATCHES / NOTES
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-[#EDEDEF] tracking-tight mt-2">
          Technical Notes
        </h1>
        <p class="mt-3 text-base text-[#A1A1AA] font-normal leading-relaxed">
          Post-mortems, architecture notes, and sprint retrospectives from our builds.
        </p>
      </div>

      {allPosts.length > 0 ? (
        <div class="space-y-4">
          {allPosts.map((post, idx) => (
            <a
              href={post.href}
              class="group block p-6 border-b border-white/[0.08] hover:bg-white/[0.015] transition-colors"
              data-scroll-reveal="card"
              style={`transition-delay: ${idx * 40}ms;`}
            >
              <div class="flex items-center justify-between text-xs font-mono text-[#8A8A93]">
                <span class="text-[#EDEDEF]">{post.date}</span>
                <span>{post.readTime}</span>
              </div>

              <h2 class="text-lg font-semibold text-[#EDEDEF] group-hover:text-white transition-colors mt-2 tracking-tight">
                {post.title}
              </h2>

              <p class="mt-1.5 text-sm text-[#A1A1AA] font-normal leading-relaxed">
                {post.description}
              </p>
            </a>
          ))}
        </div>
      ) : (
        <div class="border-t border-white/[0.08] pt-10" data-scroll-reveal="card">
          <p class="text-sm text-[#A1A1AA] leading-relaxed">
            Engineering logs, architecture post-mortems, and sprint retrospectives will be published here after our next release.
          </p>
          <div class="mt-4">
            <a 
              href="/" 
              class="inline-flex items-center gap-1.5 text-sm font-medium text-[#EDEDEF] hover:underline group"
            >
              <svg class="w-4 h-4 mr-0.5 inline-block transition-transform group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
              <span>Back to Overview</span>
            </a>
          </div>
        </div>
      )}
    </main>

    <Footer />
    <ScrollObserver />
  </body>
</html>
