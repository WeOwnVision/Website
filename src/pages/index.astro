---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HexagonVisual from "../components/HexagonVisual.astro";
import TeamCard from "../components/TeamCard.astro";
import ScrollObserver from "../components/ScrollObserver.astro";
import { siteConfig } from "../config/site";
import { teamData } from "../config/team";
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-[#0A0A0B] text-[#EDEDEF]">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteConfig.title}</title>
    <meta name="description" content={siteConfig.description} />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>

  <body class="min-h-screen bg-[#0A0A0B] text-[#EDEDEF] flex flex-col relative selection:bg-[#EDEDEF] selection:text-[#0A0A0B]">
    <!-- Top Navigation -->
    <Navigation />

    <main class="relative z-10 flex-1 flex flex-col">
      
      <!-- ================= MAIN CONTAINER: HERO, PRINCIPLES, SQUAD ================= -->
      <div id="hero-team-tracker" class="relative max-w-5xl mx-auto w-full px-6 sm:px-8 pt-8">
        
        <!-- SVG Trajectory Spine (Unified 1:1 SVG Coordinate System) -->
        <svg 
          id="trajectory-svg" 
          fill="none" 
          class="absolute inset-0 w-full h-full pointer-events-none z-10 overflow-visible hidden sm:block" 
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- Background Dashed Track Line (The Deliberate Spine) -->
          <path 
            id="hexagon-motion-path" 
            d="M 720 240 L 720 360 C 720 540, 90 560, 90 740 L 90 1310 L 90 1750" 
            stroke="rgba(255, 255, 255, 0.12)" 
            stroke-width="1.5" 
            stroke-dasharray="4 4" 
            fill="none" 
          />

          <!-- Active Tracer Line -->
          <path 
            id="hexagon-tracer-path" 
            d="M 720 240 L 720 360 C 720 540, 90 560, 90 740 L 90 1310 L 90 1750" 
            stroke="#FF5B1F" 
            stroke-width="1.8" 
            fill="none" 
          />

          <!-- Numbered Spine Node Markers -->
          <!-- Node 01: Hero Start -->
          <circle id="spine-node-01-circle" cx="720" cy="240" r="4" fill="#FF5B1F" />
          <text id="spine-node-01-text" x="696" y="244" class="text-[11px] font-mono fill-[#A1A1AA]" text-anchor="end">01</text>

          <!-- Node 02: Principles Start (Beside "How We Build" Heading) -->
          <circle id="spine-node-02-circle" cx="90" cy="740" r="4" fill="#EDEDEF" />
          <text id="spine-node-02-text" x="66" y="744" class="text-[11px] font-mono fill-[#A1A1AA]" text-anchor="end">02</text>

          <!-- Node 03: Squad Start (Beside "The Collective" Heading) -->
          <circle id="spine-node-03-circle" cx="90" cy="1310" r="4" fill="#EDEDEF" />
          <text id="spine-node-03-text" x="66" y="1314" class="text-[11px] font-mono fill-[#A1A1AA]" text-anchor="end">03</text>

          <!-- Terminal Circle Node (○ at end of Squad) -->
          <circle id="spine-node-terminal-outer" cx="90" cy="1750" r="6" stroke="#EDEDEF" stroke-width="1.5" fill="#0A0A0B" />
          <circle id="spine-node-terminal-inner" cx="90" cy="1750" r="2.5" fill="#FF5B1F" />

          <!-- THE MOVING HEXAGON: Precision Telemetry Instrument -->
          <g id="scroll-moving-hexagon" transform="translate(720, 240) scale(0.46)" class="pointer-events-auto">
            <HexagonVisual asSvgGroup={true} />
          </g>
        </svg>

        <!-- ================= 1. HERO SECTION ================= -->
        <section id="hero-section" class="relative min-h-[560px] flex items-center pb-20">
          <div class="w-full grid grid-cols-1 sm:grid-cols-12 gap-8 items-center">
            
            <!-- Left Text Content -->
            <div class="sm:col-span-8 space-y-6 text-left">
              <div class="inline-flex items-center gap-2 text-xs font-mono text-[#A1A1AA] uppercase tracking-wider hero-render-1">
                <span class="w-1.5 h-1.5 rounded-full bg-[#FF5B1F]"></span>
                <span>WeOwnVision — Hackathon Collective</span>
              </div>

              <h1 class="text-5xl sm:text-7xl lg:text-8xl font-extrabold text-[#EDEDEF] tracking-tight leading-[0.93] hero-render-2">
                Five engineers.<br />
                36 hours. Shipped.
              </h1>

              <p class="text-base sm:text-lg text-[#A1A1AA] max-w-xl font-normal leading-relaxed hero-render-3">
                We build and deploy functional software prototypes under hackathon constraints. Every project is engineered from scratch and shipped before the buzzer.
              </p>

              <div class="flex flex-wrap items-center gap-3 pt-2 hero-render-4">
                <a 
                  href="#squad-section" 
                  class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-lg text-sm font-semibold text-[#EDEDEF] bg-[#141416] hover:bg-[#1a1a1d] border border-white/15 hover:border-white/30 transition-all shadow-sm group"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-[#FF5B1F] group-hover:scale-125 transition-transform"></span>
                  <span>Meet the squad</span>
                  <span class="text-[#8A8A93] group-hover:translate-y-0.5 transition-transform text-xs">↓</span>
                </a>
                <a 
                  href={siteConfig.social.github} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-[#A1A1AA] hover:text-[#EDEDEF] hover:bg-white/[0.04] border border-white/[0.06] hover:border-white/15 transition-all group"
                >
                  <svg class="w-3.5 h-3.5 fill-current opacity-70 group-hover:opacity-100 transition-opacity" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                  <span>GitHub</span>
                  <span class="text-xs transition-transform group-hover:translate-x-0.5">→</span>
                </a>
              </div>
            </div>

            <!-- Right Spacer / Hexagon Anchor -->
            <div class="sm:col-span-4 flex items-center justify-center sm:justify-end min-h-[260px]">
              <div id="hero-hex-anchor" class="w-56 h-56 hidden sm:flex items-center justify-center"></div>
              <div class="sm:hidden w-48 h-48 flex items-center justify-center hero-render-hex">
                <HexagonVisual size="responsive" className="w-full h-full" />
              </div>
            </div>

          </div>
        </section>

        <!-- ================= 2. PRINCIPLES / HOW WE BUILD ================= -->
        <section id="principles-section" class="relative py-16 scroll-mt-20 border-t border-white/[0.08]">
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-8 items-start">
            
            <!-- Left Spine Spacer (Desktop) -->
            <div id="principles-spine-anchor" class="hidden sm:block sm:col-span-2">
              <!-- Clear room for the left spine & hexagon tracker -->
            </div>

            <!-- Right Content -->
            <div class="sm:col-span-10 space-y-8">
              <div data-scroll-reveal="text">
                <span class="text-xs font-mono text-[#A1A1AA] uppercase tracking-wider">
                  02 / PRINCIPLES
                </span>
                <h2 class="text-2xl sm:text-3xl font-bold text-[#EDEDEF] tracking-tight mt-1">
                  How We Build
                </h2>
                <p class="mt-2 text-sm text-[#A1A1AA] font-normal leading-relaxed max-w-xl">
                  Sprint discipline over slide decks. When the clock is ticking, we focus entirely on the core loop and shipping working software.
                </p>
              </div>

              <!-- Numbered List with Hairlines (Neutral numbers so orange stays rare) -->
              <div class="border-t border-white/[0.08]" data-scroll-reveal="card">
                {teamData.manifesto.values.map((val, idx) => (
                  <div class="py-6 border-b border-white/[0.08] grid grid-cols-1 md:grid-cols-12 gap-4 items-baseline">
                    <div class="md:col-span-4 flex items-baseline gap-3">
                      <span class="text-xs font-mono text-[#8A8A93]">0{idx + 1}</span>
                      <h3 class="text-base font-semibold text-[#EDEDEF] tracking-tight">
                        {val.title}
                      </h3>
                    </div>
                    <div class="md:col-span-8">
                      <p class="text-sm text-[#A1A1AA] leading-relaxed font-normal">
                        {val.description}
                      </p>
                    </div>
                  </div>
                ))}
              </div>

            </div>

          </div>
        </section>

        <!-- ================= 3. SQUAD SECTION ================= -->
        <section id="squad-section" class="relative py-16 scroll-mt-20 border-t border-white/[0.08]">
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-8 items-start">
            
            <!-- Left Spine Spacer (Desktop) -->
            <div id="squad-spine-anchor" class="hidden sm:block sm:col-span-2">
              <!-- Clear room for the left spine & hexagon tracker -->
            </div>

            <!-- Right Content: The 5 Builders Editorial List -->
            <div class="sm:col-span-10 space-y-6">
              
              <div data-scroll-reveal="text">
                <span class="text-xs font-mono text-[#A1A1AA] uppercase tracking-wider">
                  03 / THE SQUAD
                </span>
                <h2 class="text-2xl sm:text-3xl font-bold text-[#EDEDEF] tracking-tight mt-1">
                  The Collective
                </h2>
                <p class="mt-2 text-sm text-[#A1A1AA] font-normal leading-relaxed">
                  Five builders spanning distributed systems, ML pipelines, creative frontend, and product architecture.
                </p>
              </div>

              <!-- Editorial Hairline List -->
              <div class="border-t border-white/[0.08] mt-6">
                {teamData.members.map((member, idx) => (
                  <TeamCard member={member} index={idx} />
                ))}
              </div>

            </div>

          </div>
        </section>

      </div>

      <!-- ================= 4. BUILDS ARCHIVE / STANDBY STATE ================= -->
      <section class="relative max-w-5xl mx-auto w-full px-6 sm:px-8 py-16 border-t border-white/[0.08]">
        <div class="flex items-baseline justify-between mb-6" data-scroll-reveal="text">
          <div>
            <span class="text-xs font-mono text-[#A1A1AA] uppercase tracking-wider">04 / BUILDS</span>
            <h2 class="text-2xl font-bold text-[#EDEDEF] tracking-tight mt-1">
              Hackathon Drops
            </h2>
          </div>
        </div>

        <!-- Honest One-Line Editorial State Aligned with Header -->
        <div class="py-6" data-scroll-reveal="card">
          <p class="text-sm text-[#A1A1AA] leading-relaxed">
            First project write-ups and public repositories will be deployed here following our upcoming hackathons.
          </p>
          <div class="mt-3">
            <a 
              href={siteConfig.social.github} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 text-sm font-medium text-[#EDEDEF] hover:underline group"
            >
              <span>Track real-time commits on GitHub</span>
              <svg class="w-4 h-4 ml-0.5 inline-block transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </section>

    </main>

    <!-- Footer -->
    <Footer />

    <ScrollObserver />

    <!-- Viewport-Centered Motion Controller (Keeps Hexagon in Screen Middle At All Times) -->
    <script>
      function initHexagonMotion() {
        const tracker = document.getElementById("hero-team-tracker");
        const path = document.getElementById("hexagon-motion-path") as SVGPathElement | null;
        const tracerPath = document.getElementById("hexagon-tracer-path") as SVGPathElement | null;
        const movingHex = document.getElementById("scroll-moving-hexagon") as SVGGElement | null;

        if (!tracker || !path || !movingHex) return;

        let pathLength = path.getTotalLength();
        let lut: Array<{ d: number; x: number; y: number }> = [];

        function buildLUT() {
          if (!path) return;
          pathLength = path.getTotalLength();
          if (tracerPath) {
            tracerPath.style.strokeDasharray = `${pathLength}`;
          }
          const steps = 300;
          lut = [];
          for (let i = 0; i <= steps; i++) {
            const d = (i / steps) * pathLength;
            const pt = path.getPointAtLength(d);
            lut.push({ d, x: pt.x, y: pt.y });
          }
        }

        // Fast binary search to find exact point on path for any given Y coordinate
        function getPointForY(targetY: number) {
          if (!lut.length) return { x: 685, y: 260, d: 0 };
          const startY = lut[0].y;
          const endY = lut[lut.length - 1].y;

          if (targetY <= startY) return lut[0];
          if (targetY >= endY) return lut[lut.length - 1];

          let low = 0, high = lut.length - 1;
          while (low <= high) {
            const mid = (low + high) >> 1;
            if (lut[mid].y < targetY) low = mid + 1;
            else high = mid - 1;
          }
          const i = Math.min(Math.max(1, low), lut.length - 1);
          const p0 = lut[i - 1];
          const p1 = lut[i];
          const diff = p1.y - p0.y;
          const t = diff === 0 ? 0 : (targetY - p0.y) / diff;
          return {
            x: p0.x + (p1.x - p0.x) * t,
            y: targetY,
            d: p0.d + (p1.d - p0.d) * t
          };
        }

        function updateSpineLayout() {
          if (!tracker || !path) return;
          const trackerRect = tracker.getBoundingClientRect();
          const trackerTopDoc = trackerRect.top + window.scrollY;

          // Dynamically compute Hero Hex center from desktop anchor
          const heroAnchor = document.getElementById("hero-hex-anchor");
          let heroX = 700;
          let heroY = 190;
          if (heroAnchor) {
            const hRect = heroAnchor.getBoundingClientRect();
            heroX = hRect.left + hRect.width / 2 - trackerRect.left;
            heroY = hRect.top + hRect.height / 2 - trackerTopDoc;
          }

          // Dynamically compute spine gutter center from spacer column
          const spineAnchor = document.getElementById("principles-spine-anchor") || document.getElementById("squad-spine-anchor");
          let spineX = 90;
          if (spineAnchor) {
            const spRect = spineAnchor.getBoundingClientRect();
            spineX = spRect.left + spRect.width * 0.5 - trackerRect.left;
          }

          const pHeading = document.querySelector("#principles-section [data-scroll-reveal=\"text\"]") || document.querySelector("#principles-section h2");
          const sHeading = document.querySelector("#squad-section [data-scroll-reveal=\"text\"]") || document.querySelector("#squad-section h2");
          const squadSection = document.getElementById("squad-section");

          const pRect = pHeading ? pHeading.getBoundingClientRect() : null;
          const sRect = sHeading ? sHeading.getBoundingClientRect() : null;
          const squadRect = squadSection ? squadSection.getBoundingClientRect() : null;

          const principlesY = pRect ? (pRect.top + window.scrollY - trackerTopDoc + 8) : 740;
          const squadY = sRect ? (sRect.top + window.scrollY - trackerTopDoc + 8) : 1310;
          const endY = squadRect ? (squadRect.bottom + window.scrollY - trackerTopDoc - 24) : 1750;

          // Smooth architectural curve from hero into straight spine
          const curveStart = heroY + 150;
          const cpY1 = curveStart + (principlesY - curveStart) * 0.5;
          const cpY2 = principlesY - (principlesY - curveStart) * 0.4;
          const newD = `M ${heroX} ${heroY} L ${heroX} ${curveStart} C ${heroX} ${cpY1}, ${spineX} ${cpY2}, ${spineX} ${principlesY} L ${spineX} ${squadY} L ${spineX} ${endY}`;

          path.setAttribute("d", newD);
          if (tracerPath) {
            tracerPath.setAttribute("d", newD);
          }

          const n1C = document.getElementById("spine-node-01-circle");
          const n1T = document.getElementById("spine-node-01-text");
          if (n1C) { n1C.setAttribute("cx", `${heroX}`); n1C.setAttribute("cy", `${heroY}`); }
          if (n1T) { n1T.setAttribute("x", `${heroX - 24}`); n1T.setAttribute("y", `${heroY + 4}`); }

          const n2C = document.getElementById("spine-node-02-circle");
          const n2T = document.getElementById("spine-node-02-text");
          if (n2C) { n2C.setAttribute("cx", `${spineX}`); n2C.setAttribute("cy", `${principlesY}`); }
          if (n2T) { n2T.setAttribute("x", `${spineX - 22}`); n2T.setAttribute("y", `${principlesY + 4}`); }

          const n3C = document.getElementById("spine-node-03-circle");
          const n3T = document.getElementById("spine-node-03-text");
          if (n3C) { n3C.setAttribute("cx", `${spineX}`); n3C.setAttribute("cy", `${squadY}`); }
          if (n3T) { n3T.setAttribute("x", `${spineX - 22}`); n3T.setAttribute("y", `${squadY + 4}`); }

          const termOut = document.getElementById("spine-node-terminal-outer");
          const termIn = document.getElementById("spine-node-terminal-inner");
          if (termOut) { termOut.setAttribute("cx", `${spineX}`); termOut.setAttribute("cy", `${endY}`); }
          if (termIn) { termIn.setAttribute("cx", `${spineX}`); termIn.setAttribute("cy", `${endY}`); }

          buildLUT();
        }

        updateSpineLayout();

        let targetY = lut.length ? lut[0].y : 260;
        let currentY = targetY;
        let isRunning = false;

        function calculateTargetY() {
          if (!lut.length) return;
          const rect = tracker.getBoundingClientRect();
          const currentScroll = window.scrollY;
          const startY = lut[0].y;
          const endY = lut[lut.length - 1].y;

          // Target center of viewport (50% of screen height)
          const targetViewportCenter = window.innerHeight * 0.5;

          // Resting hero position in viewport coordinates:
          const heroRestingViewportY = startY + (rect.top + currentScroll);

          // Smoothly transition from resting hero position to viewport center over first 140px of scroll
          const blend = Math.min(Math.max(currentScroll / 140, 0), 1);
          const activeViewportY = (heroRestingViewportY - currentScroll) * (1 - blend) + targetViewportCenter * blend;

          // Desired Y in tracker coordinates such that: rect.top + desired = activeViewportY
          const desired = activeViewportY - rect.top;

          targetY = Math.min(Math.max(desired, startY), endY);
        }

        function updatePosition(y: number) {
          const pt = getPointForY(y);
          // Scale from 0.46 in resting hero down to 0.28 along the gutter spine
          const startY = lut.length ? lut[0].y : 240;
          const progress = Math.min(Math.max((pt.y - startY) / 220, 0), 1);
          const currentScale = 0.46 - progress * 0.18; // 0.46 -> 0.28

          movingHex.setAttribute("transform", `translate(${pt.x}, ${pt.y}) scale(${currentScale.toFixed(3)})`);

          if (tracerPath) {
            tracerPath.style.strokeDashoffset = `${pathLength - pt.d}`;
          }
        }

        function renderLoop() {
          // Physics lerp damping (0.085 for responsive, silky smooth glide)
          currentY += (targetY - currentY) * 0.085;

          updatePosition(currentY);

          if (Math.abs(targetY - currentY) > 0.15) {
            requestAnimationFrame(renderLoop);
          } else {
            currentY = targetY;
            updatePosition(currentY);
            isRunning = false;
          }
        }

        function onScroll() {
          calculateTargetY();
          if (!isRunning) {
            isRunning = true;
            requestAnimationFrame(renderLoop);
          }
        }

        function onResize() {
          updateSpineLayout();
          calculateTargetY();
          currentY = targetY;
          updatePosition(currentY);
        }

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onResize);
        window.addEventListener("load", onResize);
        if ("fonts" in document) {
          document.fonts.ready.then(onResize);
        }

        calculateTargetY();
        currentY = targetY;
        updatePosition(currentY);
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initHexagonMotion);
      } else {
        initHexagonMotion();
      }
    </script>
  </body>
</html>
