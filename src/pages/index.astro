---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HexagonVisual from "../components/HexagonVisual.astro";
import TeamCard from "../components/TeamCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ScrollObserver from "../components/ScrollObserver.astro";
import { siteConfig } from "../config/site";
import { teamData } from "../config/team";
import { getAllPosts } from "../utils/getPosts";

const recentPosts = getAllPosts().slice(0, 2);
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-black text-zinc-100">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteConfig.title}</title>
    <meta name="description" content={siteConfig.description} />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>

  <body class="min-h-screen bg-black text-zinc-100 flex flex-col relative selection:bg-white selection:text-black">
    <!-- 1. Floating Pill Navigation with Render Animation -->
    <Navigation />

    <main class="relative z-10 flex-1 flex flex-col">
      
      <!-- ================= TRACKER CONTAINER: HERO + TEAM ================= -->
      <div id="hero-team-tracker" class="relative max-w-5xl mx-auto w-full px-4 sm:px-6 pt-12">
        
        <!-- SVG Trajectory Path & Moving Hexagon (Unified 1:1 SVG Coordinate System) -->
        <svg 
          id="trajectory-svg" 
          class="absolute inset-0 w-full h-full pointer-events-none z-10 overflow-visible hidden sm:block" 
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- Background Dashed Track Line -->
          <path 
            id="hexagon-motion-path" 
            d="M 685 280 L 685 470 C 685 580, 420 620, 180 670 C 110 685, 95 720, 95 770 L 95 1360 C 95 1420, 150 1460, 220 1460" 
            stroke="#27272a" 
            stroke-width="1.8" 
            stroke-dasharray="5 5" 
            fill="none" 
          />

          <!-- Active Tracer Line -->
          <path 
            id="hexagon-tracer-path" 
            d="M 685 280 L 685 470 C 685 580, 420 620, 180 670 C 110 685, 95 720, 95 770 L 95 1360 C 95 1420, 150 1460, 220 1460" 
            stroke="#71717a" 
            stroke-width="2" 
            fill="none" 
          />

          <!-- Terminal Circle Node (○ at the end of the trajectory) -->
          <circle cx="220" cy="1460" r="7" stroke="#71717a" stroke-width="1.8" fill="#09090b" />
          <circle cx="220" cy="1460" r="2.5" fill="#ffffff" />

          <!-- THE MOVING HEXAGON: Exactly in the same SVG coordinate system! -->
          <!-- Dead-center at (685, 280) initially, zero offset, zero drift -->
          <g id="scroll-moving-hexagon" transform="translate(685, 280) scale(0.48)" class="pointer-events-auto">
            <HexagonVisual asSvgGroup={true} />
          </g>
        </svg>

        <!-- HERO SECTION (Headline on Left, Spacer on Right) -->
        <section id="hero-section" class="relative min-h-[580px] flex items-center pb-16">
          <div class="w-full grid grid-cols-1 sm:grid-cols-12 gap-8 items-center">
            
            <!-- Left Text Content with smooth cascade render animations -->
            <div class="sm:col-span-7 space-y-6 text-left">
              <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded text-xs font-mono bg-zinc-900 border border-zinc-800 text-zinc-400 hero-render-1">
                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                <span>WE OWN VISION // HACKATHON COLLECTIVE</span>
              </div>

              <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-[1.05] hero-render-2">
                We Own <br />
                The Vision.
              </h1>

              <p class="text-sm sm:text-base text-zinc-400 max-w-lg font-light leading-relaxed hero-render-3">
                Architecting resilient software prototypes and shipping end-to-end systems under 36-hour sprint constraints.
              </p>

              <div class="flex flex-wrap items-center gap-3 pt-2 hero-render-4">
                <a 
                  href="#team-section" 
                  class="px-5 py-2.5 rounded-lg text-xs font-mono font-semibold bg-white text-black hover:bg-zinc-200 transition-all duration-200 hover:-translate-y-0.5"
                >
                  Meet the Team ↓
                </a>
                <a 
                  href="/projects/" 
                  class="px-5 py-2.5 rounded-lg text-xs font-mono font-semibold bg-zinc-900 text-zinc-300 border border-zinc-800 hover:border-zinc-700 hover:text-white transition-all duration-200 hover:-translate-y-0.5"
                >
                  View Builds
                </a>
                <a 
                  href={siteConfig.social.github} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="px-4 py-2.5 rounded-lg text-xs font-mono text-zinc-500 hover:text-white transition-colors"
                >
                  GitHub →
                </a>
              </div>
            </div>

            <!-- Right Spacer / Mobile Hexagon Anchor -->
            <div class="sm:col-span-5 flex items-center justify-center sm:justify-end min-h-[220px]">
              <div class="sm:hidden w-48 h-48 flex items-center justify-center hero-render-hex">
                <HexagonVisual size="responsive" className="w-full h-full" />
              </div>
            </div>

          </div>
        </section>

        <!-- TEAM SECTION: Left rail for moving hexagon, 5 team cards on right -->
        <section id="team-section" class="relative py-16 scroll-mt-20">
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-8 items-start">
            
            <!-- Left Rail Spacer -->
            <div class="hidden sm:block sm:col-span-3 min-h-[500px]">
              <!-- Clear room for the moving hexagon on the left rail -->
            </div>

            <!-- Right Side: Manifesto + 5 Team Cards in Full Color -->
            <div class="sm:col-span-9 space-y-8">
              
              <!-- Manifesto Header -->
              <div data-scroll-reveal="text">
                <span class="text-xs font-mono text-zinc-500 uppercase tracking-wider">
                  {teamData.manifesto.badge}
                </span>

                <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mt-1">
                  What We Do &amp; Why We're Here
                </h2>

                <p class="mt-2 text-sm font-mono text-zinc-400">
                  {teamData.manifesto.tagline}
                </p>

                <p class="mt-3 text-xs sm:text-sm text-zinc-400 font-light leading-relaxed">
                  {teamData.manifesto.description}
                </p>
              </div>

              <!-- 5 Team Cards Grid -->
              <div>
                <div class="flex items-center justify-between mb-3 text-xs font-mono text-zinc-500" data-scroll-reveal="text">
                  <span>// THE SQUAD</span>
                  <span>5 MEMBERS</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {teamData.members.map((member, idx) => (
                    <div class={idx === 4 ? "sm:col-span-2" : ""}>
                      <TeamCard member={member} index={idx} />
                    </div>
                  ))}
                </div>
              </div>

            </div>

          </div>
        </section>

      </div>

      <!-- ================= 4. PROJECT SHOWCASE: 3 CARDS IN A ROW ================= -->
      <section class="relative max-w-5xl mx-auto w-full px-4 sm:px-6 py-16 border-t border-zinc-850">
        <div class="flex items-baseline justify-between mb-8" data-scroll-reveal="text">
          <div>
            <span class="text-xs font-mono text-zinc-500">// BUILDS</span>
            <h2 class="text-2xl font-bold text-white tracking-tight mt-0.5">
              Hackathon Drops
            </h2>
          </div>
          <a href="/projects/" class="text-xs font-mono text-zinc-400 hover:text-white transition-colors">
            All Projects →
          </a>
        </div>

        {teamData.projects.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            {teamData.projects.map((proj, idx) => (
              <ProjectCard project={proj} index={idx} />
            ))}
          </div>
        ) : (
          <div class="p-8 sm:p-12 rounded-2xl tech-panel text-center max-w-2xl mx-auto space-y-4" data-scroll-reveal="card">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-zinc-900 border border-zinc-800 text-zinc-400">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
              <span>STANDBY // IN DEVELOPMENT</span>
            </div>
            <h3 class="text-xl font-bold text-white tracking-tight">Active Builds Under Wraps</h3>
            <p class="text-xs sm:text-sm text-zinc-400 font-light max-w-md mx-auto leading-relaxed">
              We are currently engineering our first public hackathon drops. Prototype repositories and live deployments will be revealed here upon completion.
            </p>
            <div class="pt-1">
              <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs font-mono text-zinc-400 hover:text-white transition-colors">
                <span>Follow commits on GitHub</span> →
              </a>
            </div>
          </div>
        )}
      </section>

      <!-- Horizontal Divider Line (if posts exist) -->
      {recentPosts.length > 0 && (
        <div class="max-w-5xl mx-auto w-full px-4 sm:px-6">
          <div class="border-t border-zinc-850"></div>
        </div>
      )}

      <!-- ================= 5. BLOG / DISPATCHES: 2 WIDE CARDS ================= -->
      {recentPosts.length > 0 && (
        <section class="relative max-w-5xl mx-auto w-full px-4 sm:px-6 py-16">
          <div class="flex items-baseline justify-between mb-8" data-scroll-reveal="text">
            <div>
              <span class="text-xs font-mono text-zinc-500">// LOGS</span>
              <h2 class="text-2xl font-bold text-white tracking-tight mt-0.5">
                Latest Dispatches
              </h2>
            </div>
            <a href="/posts/" class="text-xs font-mono text-zinc-400 hover:text-white transition-colors">
              All Posts →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {recentPosts.map((post, idx) => (
              <a 
                href={post.href} 
                class="group p-6 rounded-xl tech-panel block"
                data-scroll-reveal="card"
                style={`transition-delay: ${idx * 70}ms;`}
              >
                <div class="flex items-center justify-between text-xs font-mono text-zinc-500">
                  <span>{post.date}</span>
                  <span>{post.readTime}</span>
                </div>
                <h3 class="text-lg font-bold text-white group-hover:text-zinc-300 transition-colors mt-2 tracking-tight">
                  {post.title}
                </h3>
                <p class="text-xs text-zinc-400 font-light mt-2 line-clamp-2 leading-relaxed">
                  {post.description}
                </p>
                <div class="mt-4 text-xs font-mono text-zinc-500 group-hover:text-white transition-colors">
                  Read Article →
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </main>

    <!-- 6. Footer -->
    <Footer />

    <ScrollObserver />

    <!-- Unified SVG Motion Controller with Native getPointAtLength + Lerp -->
    <script>
      function initHexagonMotion() {
        const tracker = document.getElementById('hero-team-tracker');
        const path = document.getElementById('hexagon-motion-path') as SVGPathElement | null;
        const tracerPath = document.getElementById('hexagon-tracer-path') as SVGPathElement | null;
        const movingHex = document.getElementById('scroll-moving-hexagon') as SVGGElement | null;

        if (!tracker || !path || !movingHex) return;

        const pathLength = path.getTotalLength();

        if (tracerPath) {
          tracerPath.style.strokeDasharray = `${pathLength}`;
          tracerPath.style.strokeDashoffset = `${pathLength}`;
        }

        let targetProgress = 0;
        let currentProgress = 0;
        let isRunning = false;

        function calculateTargetProgress() {
          const rect = tracker.getBoundingClientRect();
          const trackerTop = rect.top + window.scrollY;
          const startScroll = trackerTop - 40;
          const endScroll = trackerTop + tracker.offsetHeight - window.innerHeight * 0.55;
          const currentScroll = window.scrollY;

          targetProgress = Math.min(Math.max((currentScroll - startScroll) / (endScroll - startScroll), 0), 1);
        }

        function updatePosition(progress: number) {
          const pt = path.getPointAtLength(progress * pathLength);
          movingHex.setAttribute('transform', `translate(${pt.x}, ${pt.y}) scale(0.48)`);

          if (tracerPath) {
            tracerPath.style.strokeDashoffset = `${pathLength * (1 - progress)}`;
          }
        }

        function renderLoop() {
          // Physics lerp damping (0.07 for silky smooth momentum)
          currentProgress += (targetProgress - currentProgress) * 0.07;

          updatePosition(currentProgress);

          if (Math.abs(targetProgress - currentProgress) > 0.0002) {
            requestAnimationFrame(renderLoop);
          } else {
            currentProgress = targetProgress;
            updatePosition(currentProgress);
            isRunning = false;
          }
        }

        function onScroll() {
          calculateTargetProgress();
          if (!isRunning) {
            isRunning = true;
            requestAnimationFrame(renderLoop);
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', () => {
          calculateTargetProgress();
          currentProgress = targetProgress;
          updatePosition(currentProgress);
        });

        calculateTargetProgress();
        currentProgress = targetProgress;
        updatePosition(currentProgress);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initHexagonMotion);
      } else {
        initHexagonMotion();
      }
    </script>
  </body>
</html>
