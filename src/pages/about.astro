---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import HexagonVisual from "../components/HexagonVisual.astro";
import TeamCard from "../components/TeamCard.astro";
import ScrollObserver from "../components/ScrollObserver.astro";
import { siteConfig } from "../config/site";
import { teamData } from "../config/team";
---

<!DOCTYPE html>
<html lang="en" class="bg-black text-zinc-100">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>About & Squad | {siteConfig.name}</title>
    <meta name="description" content="Meet the WeOwnVision team: hackers, engineers, and designers turning visionary concepts into real products." />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>

  <body class="min-h-screen bg-black text-zinc-100 flex flex-col relative selection:bg-white selection:text-black">
    <!-- Isometric Dot Grid -->
    <div class="fixed inset-0 pointer-events-none z-0">
    </div>

    <Navigation />

    <main class="relative z-10 flex-1 max-w-5xl mx-auto px-4 sm:px-6 py-16 w-full">
      <!-- Page Header -->
      <div class="text-left max-w-2xl mb-16" data-scroll-reveal="pull-in-left">
        <span class="text-xs font-mono text-zinc-500 uppercase tracking-wider">
          // THE COLLECTIVE
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mt-1">
          About WeOwnVision
        </h1>
        <p class="mt-4 text-sm text-zinc-400 font-light leading-relaxed">
          {teamData.manifesto.description}
        </p>
      </div>

      <!-- Hexagon & Manifesto Section -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center mb-20">
        <div class="lg:col-span-5 flex justify-center">
          <HexagonVisual size="responsive" className="max-w-[320px]" />
        </div>
        <div class="lg:col-span-7 space-y-6" data-scroll-reveal="pull-in-right">
          <h2 class="text-2xl font-bold text-white tracking-tight">
            Built Under Pressure, Engineered for Tomorrow.
          </h2>
          <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed font-light">
            Our squad originated in the high-stakes pressure cooker of competitive hackathons. When you have 36 hours to take a blank repo to an award-winning deployed product, there's no room for hesitation or corporate overhead.
          </p>
          <div class="space-y-3">
            {teamData.manifesto.values.map(val => (
              <div class="p-3.5 rounded-lg tech-panel">
                <span class="font-bold text-xs text-white font-mono">{val.title}:</span>
                <span class="text-xs text-zinc-400 ml-1.5 font-light">{val.description}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Team Members Section -->
      <div class="mt-16 border-t border-zinc-850 pt-16">
        <div class="mb-8" data-scroll-reveal="scale-up">
          <span class="text-xs font-mono text-zinc-500">// ROSTER</span>
          <h2 class="text-2xl font-bold text-white tracking-tight mt-0.5">
            The Squad & Specialities (5 Members)
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {teamData.members.map((member, idx) => (
            <TeamCard member={member} index={idx} />
          ))}
        </div>
      </div>
    </main>

    <Footer />
    <ScrollObserver />
  </body>
</html>
