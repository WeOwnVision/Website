---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import TeamCard from "../components/TeamCard.astro";
import ScrollObserver from "../components/ScrollObserver.astro";
import ThemeHead from "../components/ThemeHead.astro";
import { siteConfig } from "../config/site";
import { translations } from "../i18n/translations";

const t = translations.en;
const a = t.aboutPage;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-theme-base text-theme-primary">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>About | {siteConfig.title}</title>
    <meta name="description" content="The origin story and 36-hour sprint methodology of WeOwnVision from Atatürk University." />
    <ThemeHead />
  </head>

  <body class="min-h-screen bg-theme-base text-theme-primary flex flex-col relative selection:bg-theme-accent selection:text-theme-base">
    <Navigation locale="en" />

    <main class="relative z-10 flex-1 max-w-5xl mx-auto px-6 sm:px-8 py-14 w-full">
      <!-- Page Header -->
      <div class="text-left max-w-2xl mb-16" data-scroll-reveal="text">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-theme-surface border border-theme text-xs font-mono text-theme-secondary mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-theme-accent"></span>
          <span>{a.badge}</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black text-theme-primary tracking-tight leading-[1.02]">
          {a.title}
        </h1>
        <p class="mt-4 text-base sm:text-lg text-theme-secondary font-normal leading-relaxed">
          {a.subhead}
        </p>
      </div>

      <!-- Section 1: The Origin Story & Campus Roots -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center mb-20 border-t border-theme pt-14">
        <div class="lg:col-span-5">
          <div class="p-6 sm:p-7 rounded-2xl border border-theme bg-theme-surface space-y-4 shadow-xl">
            <div class="flex items-center justify-between text-xs font-mono text-theme-muted border-b border-theme pb-3">
              <span class="text-theme-primary font-semibold">// BASE OF OPERATIONS</span>
              <span class="text-theme-accent">ERZURUM</span>
            </div>
            
            <div class="space-y-2.5 font-mono text-xs">
              <div class="flex items-center justify-between py-1 border-b border-theme/50">
                <span class="text-theme-muted">Campus</span>
                <span class="text-theme-primary font-semibold">Atatürk University</span>
              </div>
              <div class="flex items-center justify-between py-1 border-b border-theme/50">
                <span class="text-theme-muted">Squad Size</span>
                <span class="text-theme-primary">5 Engineers</span>
              </div>
              <div class="flex items-center justify-between py-1 border-b border-theme/50">
                <span class="text-theme-muted">Constraint</span>
                <span class="text-theme-accent font-bold">36 Hours Strict</span>
              </div>
              <div class="flex items-center justify-between py-1">
                <span class="text-theme-muted">Focus</span>
                <span class="text-theme-primary">Shipped Software</span>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 space-y-5" data-scroll-reveal="text">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-theme-primary tracking-tight">
            {a.storyTitle}
          </h2>
          <p class="text-sm sm:text-base text-theme-secondary leading-relaxed font-normal">
            {a.storyP1}
          </p>
          <p class="text-sm sm:text-base text-theme-secondary leading-relaxed font-normal">
            {a.storyP2}
          </p>
        </div>
      </div>

      <!-- Section 2: The 3 Rules Breakdown -->
      <div class="border-t border-theme pt-14 mb-20">
        <div class="mb-10 max-w-xl" data-scroll-reveal="text">
          <span class="text-xs font-mono font-semibold text-theme-muted uppercase tracking-wider">
            METHODOLOGY
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-theme-primary tracking-tight mt-1">
            {a.protocolTitle}
          </h2>
          <p class="mt-2 text-sm text-theme-secondary leading-relaxed">
            {a.protocolSub}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-scroll-reveal="card">
          {t.hero.manifestoRules.map((rule) => (
            <div class="p-6 rounded-2xl bg-theme-surface border border-theme space-y-3">
              <span class="text-xs font-mono font-bold text-theme-accent">
                PHASE {rule.num}
              </span>
              <h3 class="text-base font-bold text-theme-primary tracking-tight">
                {rule.name}
              </h3>
              <p class="text-xs sm:text-sm text-theme-secondary leading-relaxed">
                {rule.desc}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Section 3: The Squad Roster -->
      <div class="border-t border-theme pt-14 mb-20">
        <div class="mb-10 max-w-xl" data-scroll-reveal="text">
          <span class="text-xs font-mono font-semibold text-theme-muted uppercase tracking-wider">
            THE SQUAD
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-theme-primary tracking-tight mt-1">
            Five Members
          </h2>
          <p class="mt-2 text-sm text-theme-secondary leading-relaxed">
            Full-stack ownership across distributed systems, ML pipelines, frontend, and cloud ops.
          </p>
        </div>

        <div class="border-t border-theme">
          {t.squad.members.map((member, idx) => (
            <TeamCard member={member} index={idx} />
          ))}
        </div>
      </div>

      <!-- Section 4: Closing CTA -->
      <div class="p-8 sm:p-10 rounded-2xl bg-theme-surface border border-theme flex flex-col md:flex-row items-start md:items-center justify-between gap-6" data-scroll-reveal="card">
        <div class="space-y-2">
          <h3 class="text-xl sm:text-2xl font-bold text-theme-primary tracking-tight">
            {a.ctaTitle}
          </h3>
          <p class="text-sm text-theme-secondary max-w-lg">
            {a.ctaSub}
          </p>
        </div>

        <div class="flex items-center gap-3 flex-shrink-0">
          <a 
            href={siteConfig.social.email}
            class="btn-primary"
          >
            <span>{a.ctaButton}</span>
            <span class="text-xs">→</span>
          </a>
        </div>
      </div>

    </main>

    <Footer locale="en" />
    <ScrollObserver />
  </body>
</html>
