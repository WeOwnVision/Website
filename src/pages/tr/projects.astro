---
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import NextDropCard from "../../components/NextDropCard.astro";
import ScrollObserver from "../../components/ScrollObserver.astro";
import ThemeHead from "../../components/ThemeHead.astro";
import { siteConfig } from "../../config/site";
import { translations } from "../../i18n/translations";

const t = translations.tr;
---

<!DOCTYPE html>
<html lang="tr" class="scroll-smooth bg-theme-base text-theme-primary">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Projeler | {siteConfig.title}</title>
    <meta name="description" content="Atatürk Üniversitesi WeOwnVision ekibinin hackathon sürümleri ve aktif sprint yol haritası." />
    <ThemeHead />
  </head>

  <body class="min-h-screen bg-theme-base text-theme-primary flex flex-col relative selection:bg-theme-accent selection:text-theme-base">
    <Navigation locale="tr" />

    <main class="relative z-10 flex-1 max-w-5xl mx-auto px-6 sm:px-8 py-14 w-full">
      <div class="text-left max-w-2xl mb-12" data-scroll-reveal="text">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-theme-surface border border-theme text-xs font-mono text-theme-secondary mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-theme-accent"></span>
          <span>{t.proof.badge}</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black text-theme-primary tracking-tight mt-1">
          {t.proof.title}
        </h1>
        <p class="mt-3 text-base sm:text-lg text-theme-secondary font-normal leading-relaxed">
          {t.proof.subhead}
        </p>
      </div>

      <NextDropCard locale="tr" />
    </main>

    <Footer locale="tr" />
    <ScrollObserver />
  </body>
</html>
