---
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import TeamCard from "../../components/TeamCard.astro";
import NextDropCard from "../../components/NextDropCard.astro";
import ScrollObserver from "../../components/ScrollObserver.astro";
import ThemeHead from "../../components/ThemeHead.astro";
import { siteConfig } from "../../config/site";
import { translations } from "../../i18n/translations";

const t = translations.tr;
---

<!DOCTYPE html>
<html lang="tr" class="scroll-smooth bg-theme-base text-theme-primary">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>WeOwnVision — Hackathon Ekibi | Atatürk Üniversitesi</title>
    <meta name="description" content="Erzurum Atatürk Üniversitesi'nden 36 saatlik sprint kısıtlarında sıfırdan çalışan yazılımlar üreten beş kişilik mühendislik ekibi." />
    <ThemeHead />
  </head>

  <body class="min-h-screen bg-theme-base text-theme-primary flex flex-col relative selection:bg-theme-accent selection:text-theme-base">
    <Navigation locale="tr" />

    <main class="relative z-10 flex-1 flex flex-col">
      
      <!-- ================= 1. BALANCED 2-COLUMN HERO ================= -->
      <section id="hero-section" class="relative max-w-5xl mx-auto w-full px-6 sm:px-8 pt-14 pb-16">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          
          <!-- Sol Kolon: Başlık ve Ana Eylem -->
          <div class="lg:col-span-7 space-y-6 text-left">
            <div class="inline-flex items-center gap-2.5 px-3 py-1 rounded-full bg-theme-surface border border-theme text-xs font-mono text-theme-secondary hero-render-1">
              <span class="w-1.5 h-1.5 rounded-full bg-theme-accent"></span>
              <span>{t.campusBadge}</span>
            </div>

            <h1 class="text-5xl sm:text-7xl font-black text-theme-primary tracking-tight leading-[0.98] hero-render-2">
              Beş mühendis.<br />
              <span class="text-white">36 saat. Yayında.</span>
            </h1>

            <p class="text-base sm:text-lg text-theme-secondary max-w-xl font-normal leading-relaxed hero-render-3">
              {t.hero.subhead}
            </p>

            <div class="flex flex-wrap items-center gap-5 pt-2 hero-render-4">
              <a 
                href="#squad-section" 
                class="btn-primary"
              >
                <span>{t.hero.primaryCta}</span>
                <span class="text-xs">↓</span>
              </a>

              <a 
                href="#proof-section" 
                class="text-sm font-medium text-theme-secondary hover:text-theme-text-hover transition-colors"
              >
                {t.hero.secondaryCta}
              </a>
            </div>
          </div>

          <!-- Sağ Kolon: 36 Saatlik Sprint Kuralları Kartı -->
          <div class="lg:col-span-5 hero-render-4">
            <div class="p-6 sm:p-7 rounded-2xl bg-theme-surface border border-theme space-y-5 relative overflow-hidden">
              <div class="flex items-center justify-between border-b border-theme pb-4">
                <span class="text-xs font-mono font-bold tracking-wider text-theme-cognac uppercase">
                  {t.hero.manifestoTitle}
                </span>
                <span class="text-xs font-mono text-theme-muted">
                  36:00
                </span>
              </div>

              <div class="space-y-4">
                {t.hero.manifestoRules.map((rule) => (
                  <div class="space-y-1">
                    <div class="flex items-baseline gap-2">
                      <span class="text-xs font-mono font-bold text-theme-accent">{rule.num}</span>
                      <h4 class="text-sm font-bold text-theme-primary tracking-tight">{rule.name}</h4>
                    </div>
                    <p class="text-xs text-theme-secondary leading-relaxed pl-6">
                      {rule.desc}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- ================= 2. GELİŞTİRME KANITI ================= -->
      <section id="proof-section" class="relative max-w-5xl mx-auto w-full px-6 sm:px-8 py-16 border-t border-theme">
        <div class="space-y-2 mb-10" data-scroll-reveal="text">
          <span class="text-xs font-mono font-semibold text-theme-muted tracking-wider uppercase">
            {t.proof.badge}
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-theme-primary tracking-tight">
            {t.proof.title}
          </h2>
          <p class="text-sm sm:text-base text-theme-secondary font-normal leading-relaxed max-w-xl">
            {t.proof.subhead}
          </p>
        </div>

        <NextDropCard locale="tr" />
      </section>

      <!-- ================= 3. SPRİNT DİSİPLİNİ ================= -->
      <section id="principles-section" class="relative max-w-5xl mx-auto w-full px-6 sm:px-8 py-16 border-t border-theme">
        <div class="space-y-2 mb-10" data-scroll-reveal="text">
          <span class="text-xs font-mono font-semibold text-theme-muted tracking-wider uppercase">
            {t.principles.badge}
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-theme-primary tracking-tight">
            {t.principles.title}
          </h2>
          <p class="text-sm sm:text-base text-theme-secondary font-normal leading-relaxed max-w-xl">
            {t.principles.subhead}
          </p>
        </div>

        <div class="border-t border-theme" data-scroll-reveal="card">
          {t.principles.items.map((val) => (
            <div class="py-7 border-b border-theme grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline">
              <div class="md:col-span-5 flex items-baseline gap-3">
                <span class="text-xs font-mono font-bold text-theme-accent">{val.number}</span>
                <h3 class="text-base sm:text-lg font-bold text-theme-primary tracking-tight">
                  {val.title}
                </h3>
              </div>
              <div class="md:col-span-7">
                <p class="text-sm text-theme-secondary leading-relaxed font-normal max-w-[55ch]">
                  {val.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ================= 4. KADRO ================= -->
      <section id="squad-section" class="relative max-w-5xl mx-auto w-full px-6 sm:px-8 py-16 border-t border-theme">
        <div class="space-y-2 mb-10" data-scroll-reveal="text">
          <span class="text-xs font-mono font-semibold text-theme-muted tracking-wider uppercase">
            {t.squad.badge}
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-theme-primary tracking-tight">
            {t.squad.title}
          </h2>
          <p class="text-sm sm:text-base text-theme-secondary font-normal leading-relaxed max-w-xl">
            {t.squad.subhead}
          </p>
        </div>

        <!-- Kadro Satırları -->
        <div class="border-t border-theme">
          {t.squad.members.map((member, idx) => (
            <TeamCard member={member} index={idx} />
          ))}
        </div>
      </section>

      <!-- ================= 5. KAPANIS CTA ================= -->
      <section class="relative max-w-5xl mx-auto w-full px-6 sm:px-8 py-16 border-t border-theme">
        <div class="p-8 sm:p-10 rounded-2xl bg-theme-surface border border-theme flex flex-col md:flex-row items-start md:items-center justify-between gap-6" data-scroll-reveal="card">
          <div class="space-y-2">
            <h3 class="text-xl sm:text-2xl font-bold text-theme-primary tracking-tight">
              WeOwnVision'ı hackathonunuza davet etmek ister misiniz?
            </h3>
            <p class="text-sm text-theme-secondary max-w-lg">
              Erzurum Atatürk Üniversitesi'nden gelip sahnede çalışan kodlar üretiyoruz. Davetler ve işbirlikleri için bize ulaşın.
            </p>
          </div>

          <div class="flex items-center gap-3 flex-shrink-0">
            <a 
              href={siteConfig.social.email}
              class="btn-primary"
            >
              <span>İletişime Geçin</span>
              <span class="text-xs">→</span>
            </a>
            <a 
              href="/tr/about/"
              class="btn-secondary"
            >
              <span>Hakkımızda</span>
            </a>
          </div>
        </div>
      </section>

    </main>

    <Footer locale="tr" />
    <ScrollObserver />
  </body>
</html>
